# Nix reads apps/* while it evaluates the flake (inputs.self.submodules), before
# the dev shell can check them out: on a fresh clone, check them out first, with
# frappe-nix-sources at the revision flake.lock pins (frappe-nix docs, "A fresh clone").
if git submodule status -- apps 2> /dev/null | grep '^-' > /dev/null; then
  nix run github:Avunu/frappe-nix/release-1#bootstrap -- "$PWD" || true
fi
use flake . --no-pure-eval
