# nix / direnv / devenv
.devenv
.direnv
result

# editable python env symlink + node deps
env
node_modules

# caches / package managers
.cache
.npm
.venv
.yarn
.yarnrc

# python
**/__pycache__/*
*.pyc
.ipython
.python_history

# frappe runtime + site data (keep the dirs via .gitkeep)
#
# Scoped to sites/, NOT `**/`: a bare `**/public/*` also matches
# apps/<app>/<app>/public, and because gitignore cannot re-include a file whose
# parent directory is excluded, an app's frontend assets would silently never
# reach the index — and a flake's source tree is exactly its tracked files.
config/pids/*
!config/pids/.gitkeep
logs/*
!logs/.gitkeep
sites/assets/
sites/*/private/
sites/*/public/
sites/*/site_config.json
sites/*/locks/
sites/*/indexes/
sites/*/error-snapshots/
sites/*/backups/
sites/*/touched_tables.json
queue.rdb

# bench's record of which of its own patches have run. Per-install state, not
# source: the dev shell reconciles it against the list the installed frappe-bench
# ships on every shell entry (see lib/bench-patches.nix), so a clone that starts
# without it gets a correct one before anything can read it.
patches.txt

# classic `bench init` artifacts — superseded by frappe-nix, kept on disk
Procfile
config/*.conf
apps/*/node_modules/
apps/*/*/public/dist/
archived/
archived_sites/
.frappe-nix-backup/

# devenv reads .env (dotenv.enable), so it is where a bench's local overrides
# land — FRAPPE_SITE for a multi-tenant bench, ad-hoc credentials while
# debugging. Committed by accident more often than not. Secrets proper belong
# in secrets/*.age, which IS tracked: age ciphertext is meant to be.
.env
.env.*
!.env.example

# shell history
.bash_history
.mariadb_history
