{
  "$schema": "../document.schema.json",
  "$layout": "./layouts/docs.json",
  "$description": "Every page of the documentation: one catch-all page serves each entry of the docs collection at /docs/<path>/ (the README of docs/ is /docs/). The title, the previous and next page and the sidebar come from the generated nav data; the table of contents comes from the page's own headings. The first level-1 heading of the Markdown that says the same as the title (ignoring case and punctuation) is the page's h1, wherever it stands (it keeps its anchor); every other level-1 heading is shown as an h2 so a page has exactly one h1. Text that came from frontmatter or headings is written with the HTML-escape idiom of the Jx parser (inert.ts), so `${...}` in a title, tag or heading stays text. Every derived value is a compiler-timed Function, so the page ships no JavaScript of its own.",
  "$paths": {
    "contentType": "docs"
  },
  "title": "${state.pageTitle}",
  "state": {
    "page": {
      "$prototype": "ContentEntry",
      "contentType": "docs",
      "timing": "compiler"
    },
    "view": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "return state.nav.data.pages[state.here] || {};"
    },
    "title": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "return state.view.title || state.page.data.title || 'Untitled';"
    },
    "description": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "return state.page.data.description || state.view.description || state.config.data.tagline;"
    },
    "ogTitle": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "return state.pageTitle;"
    },
    "lede": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "return state.page.data.description || '';"
    },
    "eyebrow": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "return state.view.section || '';"
    },
    "lead": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "const kids = state.page.$children || [];\nconst norm = (t) => String(t || '').normalize('NFKD').toLowerCase().replace(/[^\\p{L}\\p{N}]+/gu, '');\nconst textOf = (n) => {\n  if (typeof n === 'string') { return n; }\n  if (Array.isArray(n)) { return n.map(textOf).join(''); }\n  if (!n || typeof n !== 'object') { return ''; }\n  if (typeof n.textContent === 'string') { return n.textContent; }\n  if (typeof n.innerHTML === 'string') { return n.innerHTML.replace(/<[^>]*>/g, '').replaceAll('&#36;', '$').replaceAll('&lt;', '<').replaceAll('&gt;', '>').replaceAll('&amp;', '&'); }\n  return textOf(n.children || []);\n};\nconst want = norm(state.title);\nconst find = (nodes, path) => {\n  for (let i = 0; i < nodes.length; i++) {\n    const n = nodes[i];\n    if (n && !Array.isArray(n) && typeof n === 'object' && n.tagName === 'h1' && norm(textOf(n)) === want) { return path.concat(i); }\n    const inner = Array.isArray(n) ? n : (n && typeof n === 'object' && Array.isArray(n.children) ? n.children : null);\n    const hit = inner ? find(inner, path.concat(i)) : null;\n    if (hit) { return hit; }\n  }\n  return null;\n};\nconst path = find(kids, []);\nif (!path) { return { kind: 'none', id: '', path: [] }; }\nlet node = kids;\npath.forEach((i) => { node = Array.isArray(node) ? node[i] : node.children[i]; });\nreturn { kind: 'title', id: node.id || '', path: path };"
    },
    "titleNodes": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "const esc = (t) => String(t).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('${', '&#36;{');\nif (state.lead.kind === 'title') {\n  let node = state.page.$children;\n  state.lead.path.forEach((i) => { node = Array.isArray(node) ? node[i] : node.children[i]; });\n  return [node];\n}\nreturn [{ tagName: 'h1', attributes: { id: 'page-title' }, innerHTML: esc(state.title) }];"
    },
    "body": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "const kids = state.page.$children || [];\nconst demote = (n) => {\n  if (Array.isArray(n)) { return n.map(demote); }\n  if (!n || typeof n !== 'object') { return n; }\n  const out = Object.assign({}, n);\n  if (out.tagName === 'h1') { out.tagName = 'h2'; }\n  if (out.children) { out.children = demote(out.children); }\n  return out;\n};\nconst without = (nodes, path) => {\n  const out = [];\n  nodes.forEach((n, i) => {\n    if (i !== path[0]) { out.push(n); return; }\n    if (path.length === 1) { return; }\n    out.push(Array.isArray(n) ? without(n, path.slice(1)) : Object.assign({}, n, { children: without(n.children, path.slice(1)) }));\n  });\n  return out;\n};\nreturn demote(state.lead.kind === 'title' ? without(kids, state.lead.path) : kids);"
    },
    "tocNodes": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "const esc = (t) => String(t).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('${', '&#36;{');\nconst shown = (h) => h.depth === 2 || h.depth === 3 || (h.depth === 1 && h.id !== state.lead.id);\nreturn (state.page._meta.toc || []).filter(shown).map((h) => ({ tagName: 'li', children: [{ tagName: 'a', attributes: { href: '#' + h.id, class: 'd' + (h.depth === 1 ? 2 : h.depth) }, innerHTML: esc(h.text) }] }));"
    },
    "hasToc": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "return (state.page._meta.toc || []).some((h) => h.depth === 2 || h.depth === 3 || (h.depth === 1 && h.id !== state.lead.id));"
    },
    "tagNodes": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "const esc = (t) => String(t).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('${', '&#36;{');\nreturn (state.page.data.tags || []).map((t) => ({ tagName: 'li', innerHTML: esc(t) }));"
    },
    "hasTags": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "return (state.page.data.tags || []).length > 0;"
    },
    "updated": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "return state.page.data.updated ? String(state.page.data.updated).slice(0, 10) : '';"
    },
    "prev": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "return state.view.prev || { title: '', url: '' };"
    },
    "next": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "return state.view.next || { title: '', url: '' };"
    },
    "editUrl": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "const c = state.config.data;\nreturn c.repo + '/edit/' + (c.branch || 'main') + '/' + 'docs' + '/' + encodeURI(state.page._meta.path);"
    },
    "pageTitle": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "const name = state.config.data.name;\nreturn state.title.toLowerCase() === name.toLowerCase() ? 'Documentation · ' + name : state.title + ' · ' + name;"
    }
  },
  "children": [
    {
      "tagName": "div",
      "style": {
        "display": "grid",
        "gridTemplateColumns": "minmax(0, 1fr) var(--toc-w)",
        "columnGap": "48px",
        "alignItems": "start",
        "padding": "36px 0 80px",
        "& > article": {
          "minWidth": "0",
          "maxWidth": "var(--container-prose)"
        },
        "& .head": {
          "display": "flex",
          "flexDirection": "column",
          "alignItems": "flex-start",
          "gap": "0",
          "marginBottom": "28px"
        },
        "& .eyebrow": {
          "margin": "0 0 16px",
          "padding": "4px 12px",
          "borderRadius": "var(--radius-pill)",
          "backgroundColor": "var(--color-tint)",
          "color": "var(--color-on-tint)",
          "fontSize": "13px",
          "fontWeight": "500",
          "lineHeight": "1.5"
        },
        "& .title h1": {
          "fontSize": "clamp(40px, 5vw, 64px)",
          "letterSpacing": "var(--tracking-tight)",
          "lineHeight": "1.06",
          "overflowWrap": "anywhere"
        },
        "& .lede": {
          "margin": "18px 0 0",
          "fontSize": "19px",
          "lineHeight": "1.55",
          "color": "var(--color-text-muted)",
          "maxWidth": "36em"
        },
        "& .meta": {
          "display": "flex",
          "flexWrap": "wrap",
          "gap": "12px 40px",
          "width": "100%",
          "margin": "24px 0 0",
          "padding": "14px 0",
          "borderTop": "1px solid var(--color-rule)",
          "borderBottom": "1px solid var(--color-rule)",
          "fontSize": "14px"
        },
        "& .meta-item": {
          "display": "flex",
          "flexDirection": "column",
          "gap": "4px"
        },
        "& .meta .k": {
          "color": "var(--color-text-caption)"
        },
        "& .tags": {
          "listStyle": "none",
          "margin": "0",
          "padding": "0",
          "display": "flex",
          "flexWrap": "wrap",
          "gap": "6px"
        },
        "& .tags li": {
          "padding": "2px 10px",
          "borderRadius": "var(--radius-pill)",
          "backgroundColor": "var(--color-tint)",
          "color": "var(--color-on-tint)",
          "fontSize": "13px"
        },
        "& .toc-inline": {
          "display": "none",
          "margin": "0 0 28px",
          "border": "1px solid var(--color-surface-border)",
          "borderRadius": "var(--radius-md)",
          "backgroundColor": "var(--color-surface)",
          "padding": "4px 16px"
        },
        "& .toc-inline > summary": {
          "minHeight": "var(--hit)",
          "display": "flex",
          "alignItems": "center",
          "fontWeight": "600",
          "fontSize": "14px"
        },
        "& .toc-inline docs-toc": {
          "padding": "0 0 14px"
        },
        "& .toc-inline docs-toc ul": {
          "borderLeft": "0"
        },
        "& .foot": {
          "marginTop": "56px",
          "paddingTop": "24px",
          "borderTop": "1px solid var(--color-rule)",
          "display": "flex",
          "flexDirection": "column",
          "gap": "24px"
        },
        "& .edit": {
          "display": "inline-flex",
          "alignItems": "center",
          "gap": "8px",
          "alignSelf": "flex-start",
          "minHeight": "var(--hit)",
          "fontSize": "14px",
          "fontWeight": "500"
        },
        "& > .toc": {
          "position": "sticky",
          "top": "calc(var(--header-h) + 32px)",
          "maxHeight": "calc(100dvh - var(--header-h) - 64px)",
          "overflowY": "auto",
          "overscrollBehavior": "contain",
          "paddingBottom": "24px"
        },
        "@--lg": {
          "gridTemplateColumns": "minmax(0, 1fr)",
          "& > .toc": {
            "display": "none"
          },
          "& .toc-inline": {
            "display": "block"
          },
          "& .toc-inline[hidden]": {
            "display": "none"
          }
        },
        "@--sm": {
          "padding": "24px 0 56px",
          "& .lede": {
            "fontSize": "17px"
          }
        }
      },
      "children": [
        {
          "tagName": "article",
          "children": [
            {
              "tagName": "header",
              "attributes": {
                "class": "head"
              },
              "children": [
                {
                  "tagName": "p",
                  "attributes": {
                    "class": "eyebrow",
                    "hidden": "${!state.eyebrow}"
                  },
                  "textContent": "${state.eyebrow}"
                },
                {
                  "tagName": "div",
                  "attributes": {
                    "class": "title"
                  },
                  "children": "${state.titleNodes}"
                },
                {
                  "tagName": "p",
                  "attributes": {
                    "class": "lede",
                    "hidden": "${!state.lede}"
                  },
                  "textContent": "${state.lede}"
                },
                {
                  "tagName": "div",
                  "attributes": {
                    "class": "meta",
                    "hidden": "${!state.updated && !state.hasTags}"
                  },
                  "children": [
                    {
                      "tagName": "div",
                      "attributes": {
                        "class": "meta-item",
                        "hidden": "${!state.updated}"
                      },
                      "children": [
                        {
                          "tagName": "span",
                          "attributes": {
                            "class": "k"
                          },
                          "textContent": "Updated"
                        },
                        {
                          "tagName": "time",
                          "attributes": {
                            "datetime": "${state.updated}"
                          },
                          "textContent": "${state.updated}"
                        }
                      ]
                    },
                    {
                      "tagName": "div",
                      "attributes": {
                        "class": "meta-item",
                        "hidden": "${!state.hasTags}"
                      },
                      "children": [
                        {
                          "tagName": "span",
                          "attributes": {
                            "class": "k"
                          },
                          "textContent": "Tags"
                        },
                        {
                          "tagName": "ul",
                          "attributes": {
                            "class": "tags",
                            "aria-label": "Tags"
                          },
                          "children": "${state.tagNodes}"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tagName": "details",
              "attributes": {
                "class": "toc-inline",
                "hidden": "${!state.hasToc}"
              },
              "children": [
                {
                  "tagName": "summary",
                  "textContent": "On this page"
                },
                {
                  "tagName": "docs-toc",
                  "children": [
                    {
                      "tagName": "nav",
                      "attributes": {
                        "aria-label": "On this page"
                      },
                      "children": [
                        {
                          "tagName": "ul",
                          "children": "${state.tocNodes}"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "tagName": "docs-prose",
              "children": "${state.body}"
            },
            {
              "tagName": "footer",
              "attributes": {
                "class": "foot"
              },
              "children": [
                {
                  "tagName": "a",
                  "attributes": {
                    "class": "edit",
                    "href": "${state.editUrl}"
                  },
                  "children": [
                    {
                      "tagName": "docs-icon",
                      "$props": {
                        "name": "pencil",
                        "size": "16"
                      }
                    },
                    {
                      "tagName": "span",
                      "children": ["Edit this page on GitHub"]
                    }
                  ]
                },
                {
                  "tagName": "docs-pager",
                  "children": [
                    {
                      "tagName": "nav",
                      "attributes": {
                        "aria-label": "Previous and next pages"
                      },
                      "children": [
                        {
                          "tagName": "a",
                          "attributes": {
                            "class": "prev",
                            "href": "${state.prev.url}",
                            "hidden": "${!state.prev.url}"
                          },
                          "children": [
                            {
                              "tagName": "span",
                              "attributes": {
                                "class": "hint"
                              },
                              "textContent": "← Previous"
                            },
                            {
                              "tagName": "span",
                              "attributes": {
                                "class": "title"
                              },
                              "textContent": "${state.prev.title}"
                            }
                          ]
                        },
                        {
                          "tagName": "a",
                          "attributes": {
                            "class": "next",
                            "href": "${state.next.url}",
                            "hidden": "${!state.next.url}"
                          },
                          "children": [
                            {
                              "tagName": "span",
                              "attributes": {
                                "class": "hint"
                              },
                              "textContent": "Next →"
                            },
                            {
                              "tagName": "span",
                              "attributes": {
                                "class": "title"
                              },
                              "textContent": "${state.next.title}"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "tagName": "aside",
          "attributes": {
            "class": "toc"
          },
          "children": [
            {
              "tagName": "docs-toc",
              "children": [
                {
                  "tagName": "nav",
                  "attributes": {
                    "aria-label": "On this page",
                    "hidden": "${!state.hasToc}"
                  },
                  "children": [
                    {
                      "tagName": "p",
                      "attributes": {
                        "class": "label"
                      },
                      "textContent": "On this page"
                    },
                    {
                      "tagName": "ul",
                      "children": "${state.tocNodes}"
                    },
                    {
                      "tagName": "a",
                      "attributes": {
                        "class": "top-link",
                        "href": "#main"
                      },
                      "children": ["Back to top ↑"]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
