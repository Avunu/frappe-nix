{
  "$schema": "./project.schema.json",
  "name": "frappe-nix",
  "url": "https://frappe-nix.avunu.net",
  "defaults": {
    "layout": "./layouts/base.json",
    "lang": "en"
  },
  "$head": [
    {
      "tagName": "meta",
      "attributes": {
        "name": "generator",
        "content": "Jx"
      }
    },
    {
      "tagName": "meta",
      "attributes": {
        "name": "theme-color",
        "content": "#FBF8F3",
        "media": "(prefers-color-scheme: light)"
      }
    },
    {
      "tagName": "meta",
      "attributes": {
        "name": "theme-color",
        "content": "#120F19",
        "media": "(prefers-color-scheme: dark)"
      }
    },
    {
      "tagName": "link",
      "attributes": {
        "rel": "icon",
        "href": "/favicon.svg",
        "type": "image/svg+xml"
      }
    },
    {
      "tagName": "link",
      "attributes": {
        "rel": "icon",
        "href": "/favicon.ico",
        "sizes": "32x32"
      }
    },
    {
      "tagName": "link",
      "attributes": {
        "rel": "preload",
        "href": "/fonts/figtree-latin-wght-normal.woff2",
        "as": "font",
        "type": "font/woff2",
        "crossorigin": ""
      }
    }
  ],
  "$media": {
    "--lg": "(max-width: 1100px)",
    "--nav": "(max-width: 960px)",
    "--md": "(max-width: 760px)",
    "--sm": "(max-width: 560px)",
    "--dark": "(prefers-color-scheme: dark)"
  },
  "style": {
    "$description": "Avunu design tokens, shared with avunu.net (names unchanged). Semantic custom properties only; components never use raw hex. Light is the base and the dark theme re-declares the semantic tokens under @--dark (OS preference) and the Jx forced-scheme contract (the theme toggle). Code panels keep their night tokens in both themes.",
    "--color-bg": "#FBF8F3",
    "--color-bg-sand": "#F3ECE2",
    "--color-bg-lavender": "#EEEAFB",
    "--color-surface": "#FFFFFF",
    "--color-surface-border": "#ECE5DA",
    "--color-surface-raised": "#FFFFFF",
    "--color-surface-muted": "#F6F3EE",
    "--color-surface-subtle": "#FAF7F2",
    "--color-text": "#181D17",
    "--color-text-muted": "#55524E",
    "--color-text-caption": "#6A665F",
    "--color-text-placeholder": "#6A665F",
    "--color-rule": "#E2DAD0",
    "--color-rule-strong": "#181D17",
    "--color-row-rule": "#EEEAE3",
    "--color-action": "#6237BF",
    "--color-action-hover": "#422580",
    "--color-on-action": "#FFFFFF",
    "--color-action-soft": "#EFEAF8",
    "--color-on-action-soft": "#422580",
    "--color-link": "#6237BF",
    "--color-link-hover": "#422580",
    "--color-tint": "#F1ECFB",
    "--color-on-tint": "#422580",
    "--color-focus": "#6237BF",
    "--color-signal": "#FFBF0D",
    "--color-violet": "#834AFF",
    "--color-code-bg": "#F3ECE2",
    "--chip-neutral-bg": "#F6F3EE",
    "--chip-neutral-text": "#55524E",
    "--chip-progress-bg": "#FFF3D1",
    "--chip-progress-text": "#6B4E00",
    "--chip-scheduled-bg": "#F1ECFB",
    "--chip-scheduled-text": "#422580",
    "--callout-note-bg": "#EEEAFB",
    "--callout-note-fg": "#422580",
    "--callout-tip-bg": "#E9F4EC",
    "--callout-tip-fg": "#1F5A30",
    "--callout-important-bg": "#F1ECFB",
    "--callout-important-fg": "#5A2FB0",
    "--callout-warning-bg": "#FFF3D1",
    "--callout-warning-fg": "#6B4E00",
    "--callout-caution-bg": "#FBE9E5",
    "--callout-caution-fg": "#8C2B1A",
    "--shadow-window": "0 30px 80px rgba(66, 37, 128, 0.12)",
    "--shadow-float": "0 10px 30px rgba(24, 29, 23, 0.10)",
    "--shadow-pill": "0 8px 24px rgba(24, 29, 23, 0.08)",
    "--shadow-dropdown": "0 18px 48px rgba(24, 29, 23, 0.14)",
    "--color-night": "#16121E",
    "--color-night-surface": "#1F1A2A",
    "--color-night-surface-3": "#2F2842",
    "--color-night-border": "#2E2740",
    "--color-night-rule": "#352E44",
    "--color-night-rule-strong": "#F4F1F8",
    "--color-night-text": "#EEEBF4",
    "--color-night-text-soft": "#DCD6E6",
    "--color-night-muted": "#ABA4BA",
    "--color-night-link": "#C9B8FF",
    "--color-night-focus": "#C9B8FF",
    "--color-night-edge": "transparent",
    "--font-sans": "'Figtree', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "--font-mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace",
    "--text-xs": "12px",
    "--text-sm": "14px",
    "--text-base": "16px",
    "--text-md": "18px",
    "--text-lg": "20px",
    "--text-title": "22px",
    "--text-h4": "26px",
    "--text-h3": "clamp(28px, 3vw, 34px)",
    "--text-h2": "clamp(30px, 3.4vw, 38px)",
    "--text-h1": "clamp(44px, 5.4vw, 72px)",
    "--text-display": "clamp(48px, 6vw, 80px)",
    "--tracking-tight": "-0.03em",
    "--tracking-snug": "-0.02em",
    "--tracking-soft": "-0.01em",
    "--radius-xs": "6px",
    "--radius-sm": "8px",
    "--radius-md": "10px",
    "--radius-panel": "12px",
    "--radius-lg": "14px",
    "--radius-xl": "16px",
    "--radius-pill": "999px",
    "--gutter": "clamp(16px, 4vw, 24px)",
    "--container": "1320px",
    "--container-prose": "46rem",
    "--header-h": "60px",
    "--hit": "44px",
    "--sidebar-w": "264px",
    "--toc-w": "224px",
    "@--dark": {
      "--color-bg": "#120F19",
      "--color-bg-sand": "#1D1826",
      "--color-bg-lavender": "#211B33",
      "--color-surface": "#1A1523",
      "--color-surface-border": "#2E2740",
      "--color-surface-raised": "#2A2240",
      "--color-surface-muted": "#241E31",
      "--color-surface-subtle": "#1F1A2A",
      "--color-text": "#EEEBF4",
      "--color-text-muted": "#B8B1C7",
      "--color-text-caption": "#A39CB3",
      "--color-text-placeholder": "#A39CB3",
      "--color-rule": "#352E44",
      "--color-rule-strong": "#EEEBF4",
      "--color-row-rule": "#2E2740",
      "--color-action": "#6237BF",
      "--color-action-hover": "#7A52D6",
      "--color-on-action": "#FFFFFF",
      "--color-action-soft": "#2B2342",
      "--color-on-action-soft": "#D9CBF7",
      "--color-link": "#C9B8FF",
      "--color-link-hover": "#E2D8FF",
      "--color-tint": "#2E2548",
      "--color-on-tint": "#D9CBF7",
      "--color-focus": "#C9B8FF",
      "--color-code-bg": "#2A2240",
      "--chip-neutral-bg": "#241E31",
      "--chip-neutral-text": "#B8B1C7",
      "--chip-progress-bg": "#3A2F0E",
      "--chip-progress-text": "#FFD877",
      "--chip-scheduled-bg": "#2B2342",
      "--chip-scheduled-text": "#D9CBF7",
      "--callout-note-bg": "#241E3A",
      "--callout-note-fg": "#D9CBF7",
      "--callout-tip-bg": "#17301F",
      "--callout-tip-fg": "#9AD7AE",
      "--callout-important-bg": "#2B2342",
      "--callout-important-fg": "#CDB8FF",
      "--callout-warning-bg": "#3A2F0E",
      "--callout-warning-fg": "#FFD877",
      "--callout-caution-bg": "#3A1B16",
      "--callout-caution-fg": "#F4A99A",
      "--shadow-window": "0 30px 80px rgba(0, 0, 0, 0.5)",
      "--shadow-float": "0 10px 30px rgba(0, 0, 0, 0.4)",
      "--shadow-pill": "0 8px 24px rgba(0, 0, 0, 0.35)",
      "--shadow-dropdown": "0 18px 48px rgba(0, 0, 0, 0.55)",
      "--color-night-edge": "#2A2337"
    },
    "margin": "0",
    "minHeight": "100vh",
    "fontFamily": "var(--font-sans)",
    "fontSize": "var(--text-base)",
    "fontWeight": "400",
    "lineHeight": "1.5",
    "backgroundColor": "var(--color-bg)",
    "color": "var(--color-text)",
    "WebkitFontSmoothing": "antialiased",
    "MozOsxFontSmoothing": "grayscale",
    "textRendering": "optimizeLegibility",
    "overflowX": "clip",
    "html": {
      "WebkitTextSizeAdjust": "100%",
      "textSizeAdjust": "100%",
      "scrollPaddingTop": "calc(var(--header-h) + 24px)",
      "@(prefers-reduced-motion: no-preference)": {
        "scrollBehavior": "smooth"
      }
    },
    "*, *::before, *::after": {
      "boxSizing": "border-box"
    },
    "h1, h2, h3, h4, h5, h6": {
      "margin": "0",
      "fontWeight": "500",
      "letterSpacing": "var(--tracking-snug)",
      "lineHeight": "1.15",
      "textWrap": "balance"
    },
    "h1": {
      "fontSize": "var(--text-h1)",
      "letterSpacing": "var(--tracking-tight)",
      "lineHeight": "1.04"
    },
    "h2": {
      "fontSize": "var(--text-h2)"
    },
    "h3": {
      "fontSize": "var(--text-title)",
      "letterSpacing": "var(--tracking-soft)"
    },
    "h4": {
      "fontSize": "var(--text-md)",
      "fontWeight": "600",
      "letterSpacing": "0"
    },
    "h5, h6": {
      "fontSize": "var(--text-base)",
      "fontWeight": "600",
      "letterSpacing": "0"
    },
    "p": {
      "margin": "0",
      "textWrap": "pretty"
    },
    "ul, ol": {
      "margin": "0",
      "paddingLeft": "1.25em"
    },
    "li": {
      "margin": "0"
    },
    "strong, b": {
      "fontWeight": "600"
    },
    "small": {
      "fontSize": "var(--text-sm)"
    },
    "img, svg, video, canvas": {
      "maxWidth": "100%"
    },
    "img, video": {
      "height": "auto"
    },
    "svg": {
      "flex": "none"
    },
    "figure": {
      "margin": "0"
    },
    "blockquote": {
      "margin": "0"
    },
    "hr": {
      "border": "0",
      "borderTop": "1px solid var(--color-rule)",
      "margin": "0"
    },
    "a": {
      "color": "var(--color-link)",
      "textUnderlineOffset": "0.18em",
      "textDecorationThickness": "1px",
      ":hover": {
        "color": "var(--color-link-hover)",
        "textDecorationThickness": "2px"
      }
    },
    "code, kbd, samp, pre": {
      "fontFamily": "var(--font-mono)",
      "fontFeatureSettings": "'calt' 0"
    },
    "code": {
      "fontSize": "0.86em",
      "backgroundColor": "var(--color-code-bg)",
      "borderRadius": "var(--radius-xs)",
      "padding": "2px 6px"
    },
    "kbd": {
      "fontSize": "12px",
      "color": "var(--color-text)",
      "backgroundColor": "var(--color-surface-muted)",
      "border": "1px solid var(--color-rule)",
      "borderRadius": "var(--radius-xs)",
      "padding": "1px 7px"
    },
    "mark": {
      "backgroundColor": "var(--chip-progress-bg)",
      "color": "var(--chip-progress-text)",
      "borderRadius": "4px",
      "padding": "0 3px"
    },
    "button, input, select, textarea": {
      "font": "inherit",
      "color": "inherit"
    },
    "button": {
      "cursor": "pointer"
    },
    "summary": {
      "cursor": "pointer"
    },
    "[hidden]": {
      "display": "none !important"
    },
    "::selection": {
      "backgroundColor": "var(--color-action)",
      "color": "var(--color-on-action)"
    },
    ":focus-visible": {
      "outline": "2px solid var(--color-focus)",
      "outlineOffset": "3px",
      "borderRadius": "4px"
    },
    ":focus:not(:focus-visible)": {
      "outline": "none"
    },
    "main:focus": {
      "outline": "none"
    },
    ".sr-only": {
      "position": "absolute",
      "width": "1px",
      "height": "1px",
      "padding": "0",
      "margin": "-1px",
      "overflow": "hidden",
      "clip": "rect(0 0 0 0)",
      "clipPath": "inset(50%)",
      "whiteSpace": "nowrap",
      "border": "0"
    },
    ".skip-link": {
      "position": "absolute",
      "left": "16px",
      "top": "-80px",
      "zIndex": "1000",
      "backgroundColor": "var(--color-action)",
      "color": "var(--color-on-action)",
      "padding": "12px 20px",
      "borderRadius": "var(--radius-pill)",
      "fontWeight": "500",
      "textDecoration": "none",
      ":focus": {
        "top": "16px",
        "color": "var(--color-on-action)"
      }
    },
    "@(prefers-reduced-motion: reduce)": {
      "*, *::before, *::after": {
        "animationDuration": "0.01ms !important",
        "animationIterationCount": "1 !important",
        "transitionDuration": "0.01ms !important",
        "scrollBehavior": "auto !important"
      }
    },
    "pre": {
      "position": "relative",
      "margin": "0",
      "padding": "0",
      "overflow": "hidden",
      "backgroundColor": "var(--color-night)",
      "color": "var(--color-night-text)",
      "border": "1px solid var(--color-night-edge)",
      "borderRadius": "var(--radius-panel)",
      "fontSize": "14px",
      "lineHeight": "1.6",
      "tabSize": "4",
      "::before": {
        "content": "''",
        "display": "block",
        "height": "37px",
        "padding": "8px 120px 8px 18px",
        "borderBottom": "1px solid var(--color-night-border)",
        "fontFamily": "var(--font-sans)",
        "fontSize": "12px",
        "lineHeight": "20px",
        "color": "var(--color-night-muted)",
        "whiteSpace": "nowrap",
        "overflow": "hidden"
      },
      "& > code": {
        "display": "block",
        "overflowX": "auto",
        "padding": "16px 18px",
        "backgroundColor": "transparent",
        "color": "inherit",
        "fontSize": "inherit",
        "borderRadius": "0",
        "whiteSpace": "pre",
        "tabSize": "4"
      },
      "& > code span": {
        "color": "var(--shiki-dark, inherit)"
      },
      "&:has(> code.language-python)::before": {
        "content": "'Python'"
      },
      "&:has(> code.language-javascript)::before": {
        "content": "'JavaScript'"
      },
      "&:has(> code.language-js)::before": {
        "content": "'JavaScript'"
      },
      "&:has(> code.language-typescript)::before": {
        "content": "'TypeScript'"
      },
      "&:has(> code.language-ts)::before": {
        "content": "'TypeScript'"
      },
      "&:has(> code.language-json)::before": {
        "content": "'JSON'"
      },
      "&:has(> code.language-bash)::before": {
        "content": "'Shell'"
      },
      "&:has(> code.language-sh)::before": {
        "content": "'Shell'"
      },
      "&:has(> code.language-shell)::before": {
        "content": "'Shell'"
      },
      "&:has(> code.language-console)::before": {
        "content": "'Shell'"
      },
      "&:has(> code.language-html)::before": {
        "content": "'HTML'"
      },
      "&:has(> code.language-css)::before": {
        "content": "'CSS'"
      },
      "&:has(> code.language-yaml)::before": {
        "content": "'YAML'"
      },
      "&:has(> code.language-yml)::before": {
        "content": "'YAML'"
      },
      "&:has(> code.language-sql)::before": {
        "content": "'SQL'"
      },
      "&:has(> code.language-php)::before": {
        "content": "'PHP'"
      },
      "&:has(> code.language-nix)::before": {
        "content": "'Nix'"
      },
      "&:has(> code.language-nginx)::before": {
        "content": "'nginx'"
      },
      "&:has(> code.language-caddyfile)::before": {
        "content": "'Caddyfile'"
      },
      "&:has(> code.language-toml)::before": {
        "content": "'TOML'"
      },
      "&:has(> code.language-ini)::before": {
        "content": "'INI'"
      },
      "&:has(> code.language-diff)::before": {
        "content": "'Diff'"
      },
      "&:has(> code.language-ruby)::before": {
        "content": "'Ruby'"
      },
      "&:has(> code.language-markdown)::before": {
        "content": "'Markdown'"
      },
      "&:has(> code.language-md)::before": {
        "content": "'Markdown'"
      },
      "&:has(> code.language-text)::before": {
        "content": "'Text'"
      },
      "&:has(> code.language-txt)::before": {
        "content": "'Text'"
      },
      "&:not(:has(> code[class*=\"language-\"]))::before": {
        "content": "'Text'"
      }
    },
    "pre .copy-btn": {
      "position": "absolute",
      "top": "5px",
      "right": "8px",
      "display": "inline-flex",
      "alignItems": "center",
      "gap": "6px",
      "minHeight": "26px",
      "padding": "2px 10px",
      "border": "1px solid var(--color-night-rule)",
      "borderRadius": "var(--radius-pill)",
      "backgroundColor": "transparent",
      "color": "var(--color-night-text)",
      "fontFamily": "var(--font-sans)",
      "fontSize": "12px",
      "cursor": "pointer",
      "--color-focus": "var(--color-night-focus)",
      ":hover": {
        "backgroundColor": "var(--color-night-surface-3)"
      },
      "&[data-state=\"copied\"]": {
        "borderColor": "var(--color-signal)"
      },
      "&::after": {
        "content": "''",
        "position": "absolute",
        "inset": "-9px -4px"
      }
    },
    "--color-night-surface-2": "#241E31",
    "--color-night-link-hover": "#FFFFFF",
    "--color-backdrop": "rgba(22, 18, 30, 0.5)"
  },
  "content": {
    "docs": {
      "source": "./.generated/docs",
      "format": "Markdown",
      "exclude": [
        "**/node_modules/**",
        "**/.*",
        "**/.*/**",
        "**/_*",
        "**/_*/**"
      ],
      "where": {
        "draft": {
          "$ne": true
        },
        "publish": {
          "$ne": false
        }
      },
      "route": "/docs/{id:slug}/",
      "indexRoute": "/docs/{dir:slug}/",
      "links": "warn",
      "alerts": {
        "NOTE": "docs-callout",
        "TIP": "docs-callout",
        "IMPORTANT": "docs-callout",
        "WARNING": "docs-callout",
        "CAUTION": "docs-callout"
      },
      "$elements": [
        {
          "$ref": "./components/docs-callout.json"
        }
      ],
      "schema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "nav_title": {
            "type": "string"
          },
          "order": {
            "type": "number"
          },
          "hidden": {
            "type": "boolean"
          },
          "draft": {
            "type": "boolean"
          },
          "publish": {
            "type": "boolean"
          },
          "updated": {
            "type": "string",
            "format": "date"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": []
      }
    },
    "nav": {
      "source": "./.generated/nav.json",
      "format": "json"
    },
    "config": {
      "source": "./docs.config.json",
      "format": "json"
    },
    "projects": {
      "source": "./data/projects.snapshot.json",
      "format": "json"
    }
  },
  "search": {
    "output": "/search-index.json",
    "collections": {
      "docs": {
        "basePath": "/docs/",
        "boost": {
          "title": 4,
          "heading": 2
        }
      }
    }
  },
  "build": {
    "outDir": "./dist",
    "trailingSlash": "always",
    "headers": {
      "enabled": false
    }
  },
  "extensions": [
    "@jxsuite/parser",
    "@jxsuite/search"
  ]
}
