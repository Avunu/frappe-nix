{
  "$schema": "../document.schema.json",
  "$id": "DocsProse",
  "$description": "Article typography for Markdown: a 46rem measure, 17px/1.7 body, headings with hover anchors, lists, blockquotes, tables (scroll inside their own box), inline code, keyboard keys, definition lists and details. Code blocks are Night panels with a language label and a copy button; the global stylesheet draws them and docs-enhance adds the button and the heading anchors. GitHub alerts are rendered by docs-callout. Wrap the Markdown body of every page in it.",
  "tagName": "docs-prose",
  "style": {
    "display": "block",
    "maxWidth": "var(--container-prose)",
    "fontSize": "17px",
    "lineHeight": "1.7",
    "color": "var(--color-text)",
    "overflowWrap": "break-word",
    "& > * + *": {
      "marginTop": "20px"
    },
    "& > :first-child": {
      "marginTop": "0"
    },
    "& h2": {
      "fontSize": "30px",
      "lineHeight": "1.2",
      "letterSpacing": "var(--tracking-snug)",
      "marginTop": "44px",
      "paddingTop": "0"
    },
    "& h3": {
      "fontSize": "20px",
      "lineHeight": "1.3",
      "fontWeight": "600",
      "letterSpacing": "var(--tracking-soft)",
      "marginTop": "32px"
    },
    "& h4": {
      "fontSize": "17px",
      "marginTop": "28px"
    },
    "& h2 + *, & h3 + *, & h4 + *": {
      "marginTop": "12px"
    },
    "& ul, & ol": {
      "paddingLeft": "1.3em",
      "display": "flex",
      "flexDirection": "column",
      "gap": "8px"
    },
    "& li > p": {
      "display": "block"
    },
    "& li > ul, & li > ol": {
      "marginTop": "8px"
    },
    "& li::marker": {
      "color": "var(--color-text-caption)"
    },
    "& a": {
      "fontWeight": "500",
      "overflowWrap": "anywhere"
    },
    "& blockquote": {
      "borderLeft": "3px solid var(--color-action)",
      "paddingLeft": "20px",
      "color": "var(--color-text-muted)",
      "fontSize": "19px",
      "lineHeight": "1.55"
    },
    "& blockquote p + p": {
      "marginTop": "12px"
    },
    "& hr": {
      "marginBlock": "40px"
    },
    "& img": {
      "borderRadius": "var(--radius-panel)",
      "display": "block"
    },
    "& figcaption": {
      "marginTop": "8px",
      "fontSize": "var(--text-sm)",
      "color": "var(--color-text-caption)"
    },
    "& table": {
      "display": "block",
      "maxWidth": "100%",
      "overflowX": "auto",
      "borderCollapse": "collapse",
      "fontSize": "15px",
      "lineHeight": "1.5",
      "marginTop": "20px"
    },
    "& th, & td": {
      "padding": "10px 16px 10px 0",
      "textAlign": "left",
      "verticalAlign": "top",
      "borderBottom": "1px solid var(--color-row-rule)"
    },
    "& th": {
      "fontWeight": "600",
      "whiteSpace": "nowrap",
      "borderBottom": "2px solid var(--color-rule-strong)"
    },
    "& td:last-child, & th:last-child": {
      "paddingRight": "0"
    },
    "& tr:last-child td": {
      "borderBottom": "0"
    },
    "& th[align=\"right\"], & td[align=\"right\"]": {
      "textAlign": "right"
    },
    "& details": {
      "border": "1px solid var(--color-surface-border)",
      "borderRadius": "var(--radius-md)",
      "padding": "12px 16px"
    },
    "& dl": {
      "display": "grid",
      "gridTemplateColumns": "max-content 1fr",
      "gap": "8px 20px"
    },
    "& dt": {
      "fontWeight": "600"
    },
    "& dd": {
      "margin": "0",
      "color": "var(--color-text-muted)"
    },
    "& kbd": {
      "fontSize": "0.8em"
    },
    "& .anchor": {
      "marginLeft": "8px",
      "fontWeight": "400",
      "textDecoration": "none",
      "color": "var(--color-text-caption)",
      "opacity": "0",
      "transition": "opacity 0.12s"
    },
    "& h2:hover .anchor, & h3:hover .anchor, & h4:hover .anchor, & .anchor:focus-visible": {
      "opacity": "1"
    },
    "& .anchor:hover": {
      "color": "var(--color-link)"
    },
    "@(prefers-reduced-motion: reduce)": {
      "& .anchor": {
        "transition": "none"
      }
    },
    "& a[href^=\"http\"]:not(.anchor)": {
      "overflowWrap": "anywhere"
    },
    "& .jx-alert, & blockquote[role=\"note\"]": {
      "padding": "14px 18px",
      "borderRadius": "var(--radius-panel)",
      "backgroundColor": "var(--callout-note-bg)"
    },
    "& li > p:first-child": {
      "marginTop": "0"
    }
  },
  "children": [
    {
      "tagName": "slot"
    }
  ]
}
