{
  "$schema": "../document.schema.json",
  "$id": "DocsCallout",
  "$description": "Callout for GitHub alerts (`> [!NOTE]`, `[!TIP]`, `[!IMPORTANT]`, `[!WARNING]`, `[!CAUTION]`). project.json maps every alert type to this component, so the Markdown parser emits it with `data-alert` (note, tip, important, warning or caution) and, when the author wrote a custom title, `data-title`. The default title and the icon come from those attributes. Also usable by hand: :::docs-callout{data-alert=\"tip\"}.",
  "tagName": "docs-callout",
  "style": {
    "display": "block",
    "position": "relative",
    "margin": "1.25em 0",
    "padding": "16px 18px 16px 52px",
    "borderRadius": "var(--radius-panel)",
    "backgroundColor": "var(--callout-note-bg)",
    "color": "var(--color-text)",
    "fontSize": "16px",
    "lineHeight": "1.65",
    "textAlign": "left",
    "::before": {
      "content": "'Note'",
      "display": "block",
      "fontSize": "15px",
      "fontWeight": "600",
      "lineHeight": "1.5",
      "color": "var(--callout-note-fg)",
      "marginBottom": "2px"
    },
    "&[data-title]::before": {
      "content": "attr(data-title)"
    },
    "& .icon": {
      "position": "absolute",
      "left": "18px",
      "top": "17px",
      "color": "var(--callout-note-fg)",
      "lineHeight": "0"
    },
    "& .icon > *": {
      "display": "none"
    },
    "& .i-note": {
      "display": "block"
    },
    "& .body > :first-child": {
      "marginTop": "0"
    },
    "& .body > :last-child": {
      "marginBottom": "0"
    },
    "& .body > * + *": {
      "marginTop": "0.75em"
    },
    "& code": {
      "backgroundColor": "var(--color-surface-raised)"
    },
    "&[data-alert=\"note\"]": {
      "backgroundColor": "var(--callout-note-bg)"
    },
    "&[data-alert=\"note\"]::before": {
      "content": "'Note'",
      "color": "var(--callout-note-fg)"
    },
    "&[data-alert=\"note\"] .i-note": {
      "display": "block"
    },
    "&[data-alert=\"note\"] .icon": {
      "color": "var(--callout-note-fg)"
    },
    "&[data-alert=\"tip\"]": {
      "backgroundColor": "var(--callout-tip-bg)"
    },
    "&[data-alert=\"tip\"]::before": {
      "content": "'Tip'",
      "color": "var(--callout-tip-fg)"
    },
    "&[data-alert=\"tip\"] .i-tip": {
      "display": "block"
    },
    "&[data-alert=\"tip\"] .icon": {
      "color": "var(--callout-tip-fg)"
    },
    "&[data-alert=\"important\"]": {
      "backgroundColor": "var(--callout-important-bg)"
    },
    "&[data-alert=\"important\"]::before": {
      "content": "'Important'",
      "color": "var(--callout-important-fg)"
    },
    "&[data-alert=\"important\"] .i-important": {
      "display": "block"
    },
    "&[data-alert=\"important\"] .icon": {
      "color": "var(--callout-important-fg)"
    },
    "&[data-alert=\"warning\"]": {
      "backgroundColor": "var(--callout-warning-bg)"
    },
    "&[data-alert=\"warning\"]::before": {
      "content": "'Warning'",
      "color": "var(--callout-warning-fg)"
    },
    "&[data-alert=\"warning\"] .i-warning": {
      "display": "block"
    },
    "&[data-alert=\"warning\"] .icon": {
      "color": "var(--callout-warning-fg)"
    },
    "&[data-alert=\"caution\"]": {
      "backgroundColor": "var(--callout-caution-bg)"
    },
    "&[data-alert=\"caution\"]::before": {
      "content": "'Caution'",
      "color": "var(--callout-caution-fg)"
    },
    "&[data-alert=\"caution\"] .i-caution": {
      "display": "block"
    },
    "&[data-alert=\"caution\"] .icon": {
      "color": "var(--callout-caution-fg)"
    },
    "&[data-alert=\"tip\"] .i-note": {
      "display": "none"
    },
    "&[data-alert=\"important\"] .i-note": {
      "display": "none"
    },
    "&[data-alert=\"warning\"] .i-note": {
      "display": "none"
    },
    "&[data-alert=\"caution\"] .i-note": {
      "display": "none"
    }
  },
  "children": [
    {
      "tagName": "span",
      "attributes": {
        "class": "icon",
        "aria-hidden": "true"
      },
      "children": [
        {
          "tagName": "span",
          "attributes": {
            "class": "i-note"
          },
          "children": [
            {
              "tagName": "docs-icon",
              "$props": {
                "name": "info",
                "size": "22"
              }
            }
          ]
        },
        {
          "tagName": "span",
          "attributes": {
            "class": "i-tip"
          },
          "children": [
            {
              "tagName": "docs-icon",
              "$props": {
                "name": "lightbulb",
                "size": "22"
              }
            }
          ]
        },
        {
          "tagName": "span",
          "attributes": {
            "class": "i-important"
          },
          "children": [
            {
              "tagName": "docs-icon",
              "$props": {
                "name": "message-alert",
                "size": "22"
              }
            }
          ]
        },
        {
          "tagName": "span",
          "attributes": {
            "class": "i-warning"
          },
          "children": [
            {
              "tagName": "docs-icon",
              "$props": {
                "name": "triangle-alert",
                "size": "22"
              }
            }
          ]
        },
        {
          "tagName": "span",
          "attributes": {
            "class": "i-caution"
          },
          "children": [
            {
              "tagName": "docs-icon",
              "$props": {
                "name": "octagon-alert",
                "size": "22"
              }
            }
          ]
        }
      ]
    },
    {
      "tagName": "div",
      "attributes": {
        "class": "body",
        "role": "note"
      },
      "children": [
        {
          "tagName": "slot"
        }
      ]
    }
  ]
}
