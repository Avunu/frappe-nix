{
  "$schema": "../document.schema.json",
  "$id": "DocsToc",
  "$description": "Styling for the \"On this page\" list. Put a <nav aria-label=\"On this page\"> in the default slot with a .label paragraph and a <ul> of links; a link carries class d2 or d3 for its heading depth. docs-enhance marks the heading in view with aria-current=\"location\".",
  "tagName": "docs-toc",
  "style": {
    "display": "block",
    "fontSize": "13px",
    "lineHeight": "1.45",
    "& .label": {
      "margin": "0 0 10px",
      "fontSize": "12px",
      "fontWeight": "600",
      "color": "var(--color-text)"
    },
    "& ul": {
      "listStyle": "none",
      "margin": "0",
      "padding": "0",
      "display": "flex",
      "flexDirection": "column",
      "borderLeft": "1px solid var(--color-rule)"
    },
    "& a": {
      "display": "block",
      "marginLeft": "-1px",
      "padding": "4px 12px",
      "borderLeft": "2px solid transparent",
      "color": "var(--color-text-muted)",
      "textDecoration": "none",
      "overflowWrap": "anywhere"
    },
    "& a.d3": {
      "paddingLeft": "24px"
    },
    "& a:hover": {
      "color": "var(--color-text)"
    },
    "& a[aria-current=\"location\"]": {
      "borderLeftColor": "var(--color-action)",
      "color": "var(--color-on-tint)",
      "fontWeight": "600"
    },
    "& .top-link": {
      "display": "inline-block",
      "marginTop": "14px",
      "padding": "0 0 0 1px",
      "fontSize": "13px",
      "color": "var(--color-link)"
    }
  },
  "children": [
    {
      "tagName": "slot"
    }
  ]
}
