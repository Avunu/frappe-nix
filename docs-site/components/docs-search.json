{
  "$schema": "../document.schema.json",
  "$id": "DocsSearch",
  "$description": "Docs search palette over the @jxsuite/search index (MiniSearch in the browser, no server and no third party). A trigger (variant=field: the rounded field with a / hint; variant=icon: a 44px icon button) opens a native-popover modal with live results. Hotkeys: / and Cmd/Ctrl+K. The index loads only when the palette opens. Props: variant (field or icon), label, links (the 'Jump to' shortcuts: [{ label, href }]).",
  "state": {
    "searchQuery": "",
    "searchResults": [],
    "searchCount": 0,
    "searchReady": false,
    "searchActive": 0,
    "searchInit": {
      "$prototype": "Function",
      "$src": "npm:@jxsuite/search/client",
      "$lazy": true,
      "parameters": ["state"]
    },
    "runSearch": {
      "$prototype": "Function",
      "$src": "npm:@jxsuite/search/client",
      "$lazy": true,
      "parameters": ["state", "e"]
    },
    "onMount": {
      "$prototype": "Function",
      "arguments": ["state"],
      "body": "const host = this; const boot = () => state.searchInit(state); const pop = host.querySelector('#site-search-modal'); if (pop) { pop.addEventListener('toggle', (ev) => { const inp = pop.querySelector('input'); if (ev.newState === 'open') { boot(); if (inp) { inp.focus(); inp.select(); } } else { if (inp) { inp.value = ''; } state.searchQuery = ''; state.searchResults = []; state.searchCount = 0; state.searchActive = 0; } }); } if (!document.__jxSearchHotkeys) { document.__jxSearchHotkeys = true; document.addEventListener('keydown', (ev) => { const t = ev.target; const tag = t && t.tagName; const typing = tag === 'INPUT' || tag === 'TEXTAREA' || (t && t.isContentEditable); if (((ev.metaKey || ev.ctrlKey) && ev.key === 'k') || (ev.key === '/' && !typing)) { const p = document.getElementById('site-search-modal'); if (p && !p.matches(':popover-open')) { ev.preventDefault(); p.showPopover(); } } }); }"
    },
    "variant": "field",
    "label": "Search the docs",
    "links": []
  },
  "tagName": "docs-search",
  "style": {
    "display": "block",
    "& .mag": {
      "position": "relative",
      "display": "inline-block",
      "flex": "none",
      "width": "0.72rem",
      "height": "0.72rem",
      "border": "1.5px solid currentColor",
      "borderRadius": "50%",
      "opacity": "0.85"
    },
    "& .mag::after": {
      "content": "''",
      "position": "absolute",
      "top": "100%",
      "left": "100%",
      "width": "1.5px",
      "height": "0.38rem",
      "background": "currentColor",
      "borderRadius": "1px",
      "transform": "translate(-1.5px, -1.5px) rotate(-45deg)",
      "transformOrigin": "top center"
    },
    "& .mag-lg": {
      "width": "0.92rem",
      "height": "0.92rem",
      "borderWidth": "1.75px"
    },
    "& .mag-lg::after": {
      "width": "1.75px",
      "height": "0.5rem"
    },
    "& .search-row": {
      "display": "flex",
      "alignItems": "flex-start",
      "gap": "0.7rem",
      "padding": "0.55rem 0.7rem",
      "borderRadius": "8px",
      "textDecoration": "none",
      "color": "var(--color-text)",
      "scrollMarginBlock": "0.4rem"
    },
    "& .search-row:hover": {
      "backgroundColor": "var(--color-surface-muted)"
    },
    "& .search-row.is-active": {
      "backgroundColor": "var(--color-surface-muted)",
      "boxShadow": "inset 0 0 0 1px var(--color-row-rule)"
    },
    "& .row-icon": {
      "flex": "none",
      "width": "1.1rem",
      "marginTop": "0.55rem",
      "textAlign": "center",
      "fontSize": "0.8rem",
      "lineHeight": "1",
      "color": "var(--color-text-caption)"
    },
    "& .row-body": {
      "flex": "1",
      "minWidth": "0"
    },
    "& .row-crumbs": {
      "fontSize": "0.6875rem",
      "color": "var(--color-text-caption)",
      "whiteSpace": "nowrap",
      "overflow": "hidden",
      "textOverflow": "ellipsis"
    },
    "& .row-title": {
      "fontSize": "0.875rem",
      "fontWeight": "600",
      "lineHeight": "1.35",
      "whiteSpace": "nowrap",
      "overflow": "hidden",
      "textOverflow": "ellipsis"
    },
    "& .row-excerpt": {
      "marginTop": "0.15rem",
      "fontSize": "0.78rem",
      "lineHeight": "1.45",
      "color": "var(--color-text-caption)",
      "display": "-webkit-box",
      "WebkitLineClamp": "2",
      "WebkitBoxOrient": "vertical",
      "overflow": "hidden"
    },
    "& .hl": {
      "backgroundColor": "color-mix(in srgb, var(--color-action) 22%, transparent)",
      "color": "var(--color-text)",
      "borderRadius": "3px",
      "padding": "0 0.1em",
      "fontWeight": "600"
    },
    "& .row-enter": {
      "flex": "none",
      "alignSelf": "center",
      "fontSize": "0.8rem",
      "color": "var(--color-text-caption)",
      "opacity": "0",
      "transition": "opacity 0.12s"
    },
    "& .search-row.is-active .row-enter": {
      "opacity": "1"
    },
    "& .quick-link": {
      "display": "block",
      "padding": "0.4rem 0.7rem",
      "borderRadius": "6px",
      "fontSize": "0.8125rem",
      "color": "var(--color-text-caption)",
      "textDecoration": "none"
    },
    "& .quick-link:hover": {
      "backgroundColor": "var(--color-surface-muted)",
      "color": "var(--color-text)"
    },
    "& .foot-key": {
      "fontFamily": "inherit",
      "fontSize": "0.6875rem",
      "border": "1px solid var(--color-rule)",
      "borderRadius": "4px",
      "padding": "0.05rem 0.3rem",
      "marginRight": "0.3rem",
      "color": "var(--color-text-caption)"
    }
  },
  "children": [
    {
      "tagName": "button",
      "style": {
        "display": "inline-flex",
        "alignItems": "center",
        "gap": "10px",
        "minHeight": "var(--hit)",
        "backgroundColor": "var(--color-surface)",
        "border": "1px solid var(--color-rule)",
        "borderRadius": "var(--radius-pill)",
        "color": "var(--color-text-muted)",
        "padding": "4px 8px 4px 16px",
        "fontSize": "14px",
        "textAlign": "left",
        "transition": "border-color 0.15s, color 0.15s",
        ":hover": {
          "color": "var(--color-text)",
          "borderColor": "var(--color-text-caption)"
        },
        "&[data-variant=\"field\"]": {
          "width": "100%",
          "justifyContent": "flex-start"
        },
        "&[data-variant=\"field\"] .label": {
          "flex": "1 1 auto",
          "minWidth": "0",
          "color": "var(--color-text-placeholder)"
        },
        "&[data-variant=\"icon\"]": {
          "width": "var(--hit)",
          "padding": "0",
          "justifyContent": "center",
          "borderColor": "transparent",
          "backgroundColor": "transparent"
        },
        "&[data-variant=\"icon\"] .label, &[data-variant=\"icon\"] kbd": {
          "display": "none"
        },
        "& kbd": {
          "fontSize": "12px"
        },
        "& .ico": {
          "display": "inline-flex",
          "lineHeight": "0"
        }
      },
      "attributes": {
        "type": "button",
        "popovertarget": "site-search-modal",
        "aria-label": "Search the docs",
        "data-variant": "${state.variant}"
      },
      "children": [
        {
          "tagName": "span",
          "attributes": {
            "class": "ico",
            "aria-hidden": "true"
          },
          "children": [
            {
              "tagName": "svg",
              "attributes": {
                "viewBox": "0 0 24 24",
                "width": "18",
                "height": "18",
                "fill": "none",
                "stroke": "currentColor",
                "stroke-width": "1.6",
                "stroke-linecap": "round",
                "stroke-linejoin": "round",
                "aria-hidden": "true",
                "focusable": "false"
              },
              "children": [
                {
                  "tagName": "path",
                  "attributes": {
                    "d": "M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4-4"
                  }
                }
              ]
            }
          ]
        },
        {
          "tagName": "span",
          "attributes": {
            "class": "label"
          },
          "textContent": "${state.label}"
        },
        {
          "tagName": "kbd",
          "attributes": {
            "aria-hidden": "true"
          },
          "textContent": "/"
        }
      ],
      "$title": "Search Trigger"
    },
    {
      "$title": "Search Modal",
      "tagName": "div",
      "id": "site-search-modal",
      "attributes": {
        "popover": "auto",
        "data-scope": "themed"
      },
      "style": {
        "width": "min(640px, 94vw)",
        "margin": "10vh auto auto",
        "padding": "0",
        "overflow": "hidden",
        "backgroundColor": "var(--color-surface)",
        "border": "1px solid var(--color-rule)",
        "borderRadius": "var(--radius-xl)",
        "boxShadow": "var(--shadow-dropdown)",
        "opacity": "0",
        "transform": "translateY(-8px)",
        "transition": "opacity 0.15s ease, transform 0.15s ease, display 0.15s allow-discrete, overlay 0.15s allow-discrete",
        ":popover-open": {
          "opacity": "1",
          "transform": "translateY(0)"
        },
        "::backdrop": {
          "backgroundColor": "rgba(0, 0, 0, 0.45)",
          "backdropFilter": "blur(2px)",
          "opacity": "0",
          "transition": "opacity 0.15s ease, display 0.15s allow-discrete, overlay 0.15s allow-discrete"
        },
        "&:popover-open::backdrop": {
          "opacity": "1"
        },
        "@starting-style": {
          ":popover-open": {
            "opacity": "0",
            "transform": "translateY(-8px)"
          },
          "&:popover-open::backdrop": {
            "opacity": "0"
          }
        },
        "@(prefers-reduced-motion: reduce)": {
          "transition": "none",
          "transform": "none",
          ":popover-open": {
            "transform": "none"
          },
          "::backdrop": {
            "transition": "none"
          }
        },
        "color": "var(--color-text)"
      },
      "children": [
        {
          "$title": "Search Header",
          "tagName": "div",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "gap": "0.7rem",
            "padding": "0 0.9rem",
            "borderBottom": "1px solid var(--color-rule)",
            "color": "var(--color-text-caption)"
          },
          "children": [
            {
              "tagName": "span",
              "attributes": {
                "class": "mag mag-lg",
                "aria-hidden": "true"
              }
            },
            {
              "tagName": "input",
              "attributes": {
                "type": "text",
                "name": "site-search-query",
                "placeholder": "Search the docs…",
                "aria-label": "Search the docs",
                "autocomplete": "off",
                "autocorrect": "off",
                "spellcheck": "false",
                "role": "combobox",
                "aria-autocomplete": "list",
                "aria-controls": "site-search-listbox",
                "aria-expanded": "${state.searchResults.length > 0 ? 'true' : 'false'}",
                "aria-activedescendant": "${state.searchResults.length > 0 ? 'jx-sr-' + state.searchActive : ''}"
              },
              "oninput": {
                "$ref": "#/state/runSearch"
              },
              "onkeydown": {
                "$prototype": "Function",
                "arguments": ["state", "e"],
                "body": "const r = state.searchResults || []; const n = r.length; const go = (i) => { state.searchActive = i; requestAnimationFrame(() => { const el = document.getElementById('jx-sr-' + i); if (el) { el.scrollIntoView({ block: 'nearest' }); } }); }; if (e.key === 'ArrowDown') { e.preventDefault(); if (n) { go((state.searchActive + 1) % n); } } else if (e.key === 'ArrowUp') { e.preventDefault(); if (n) { go((state.searchActive - 1 + n) % n); } } else if (e.key === 'Home' && n) { e.preventDefault(); go(0); } else if (e.key === 'End' && n) { e.preventDefault(); go(n - 1); } else if (e.key === 'Enter') { const hit = r[state.searchActive]; if (hit) { e.preventDefault(); if (e.metaKey || e.ctrlKey) { window.open(hit.url, '_blank', 'noopener'); } else { location.href = hit.url; } } }"
              },
              "style": {
                "flex": "1",
                "minWidth": "0",
                "background": "transparent",
                "border": "none",
                "outline": "none",
                "color": "var(--color-text)",
                "fontSize": "1rem",
                "padding": "0.95rem 0",
                ":focus-visible": {
                  "outline": "none"
                }
              }
            },
            {
              "tagName": "button",
              "attributes": {
                "type": "button",
                "popovertarget": "site-search-modal",
                "popovertargetaction": "hide",
                "aria-label": "Close search"
              },
              "style": {
                "flex": "none",
                "background": "transparent",
                "border": "1px solid var(--color-rule)",
                "borderRadius": "5px",
                "color": "var(--color-text-caption)",
                "cursor": "pointer",
                "fontFamily": "inherit",
                "fontSize": "0.6875rem",
                "letterSpacing": "0.04em",
                "padding": "0.15rem 0.4rem",
                "transition": "color 0.15s, border-color 0.15s",
                ":hover": {
                  "color": "var(--color-text)",
                  "borderColor": "var(--color-text-caption)"
                }
              },
              "children": ["ESC"]
            }
          ]
        },
        {
          "$title": "Results Panel",
          "tagName": "div",
          "style": {
            "maxHeight": "min(60vh, 26rem)",
            "overflowY": "auto",
            "overscrollBehavior": "contain",
            "padding": "0.4rem"
          },
          "children": [
            {
              "$title": "Results",
              "tagName": "div",
              "id": "site-search-listbox",
              "attributes": {
                "role": "listbox",
                "aria-label": "Search results",
                "hidden": "${state.searchResults.length === 0}"
              },
              "children": [
                {
                  "$prototype": "Array",
                  "items": {
                    "$ref": "#/state/searchResults"
                  },
                  "map": {
                    "tagName": "a",
                    "id": "jx-sr-${index}",
                    "attributes": {
                      "href": "${item.url}",
                      "role": "option",
                      "aria-selected": "${index === state.searchActive ? 'true' : 'false'}",
                      "class": "search-row ${index === state.searchActive ? 'is-active' : ''}"
                    },
                    "children": [
                      {
                        "tagName": "span",
                        "attributes": {
                          "class": "row-icon",
                          "aria-hidden": "true"
                        },
                        "textContent": "${item.heading ? '#' : '▤'}"
                      },
                      {
                        "tagName": "span",
                        "attributes": {
                          "class": "row-body"
                        },
                        "children": [
                          {
                            "tagName": "span",
                            "attributes": {
                              "class": "row-crumbs"
                            },
                            "style": {
                              "display": "${item.crumbs.length ? 'block' : 'none'}"
                            },
                            "textContent": "${item.crumbs.join(' › ')}"
                          },
                          {
                            "tagName": "span",
                            "attributes": {
                              "class": "row-title"
                            },
                            "children": [
                              {
                                "$prototype": "Array",
                                "items": {
                                  "$ref": "$map/item/titleTokens"
                                },
                                "map": {
                                  "tagName": "span",
                                  "attributes": {
                                    "class": "${item.m ? 'hl' : ''}"
                                  },
                                  "textContent": "${item.t}"
                                }
                              }
                            ]
                          },
                          {
                            "tagName": "span",
                            "attributes": {
                              "class": "row-excerpt"
                            },
                            "children": [
                              {
                                "$prototype": "Array",
                                "items": {
                                  "$ref": "$map/item/excerptTokens"
                                },
                                "map": {
                                  "tagName": "span",
                                  "attributes": {
                                    "class": "${item.m ? 'hl' : ''}"
                                  },
                                  "textContent": "${item.t}"
                                }
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "tagName": "span",
                        "attributes": {
                          "class": "row-enter",
                          "aria-hidden": "true"
                        },
                        "textContent": "↵"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "$title": "Empty State",
              "tagName": "div",
              "attributes": {
                "role": "status"
              },
              "textContent": "${!state.searchQuery ? '' : state.searchResults.length ? '' : state.searchReady ? 'No results for “' + state.searchQuery + '”' : 'Loading the search index…'}",
              "style": {
                "color": "var(--color-text-caption)",
                "fontSize": "0.85rem",
                "textAlign": "center",
                "padding": "${state.searchQuery && !state.searchResults.length ? '1.6rem 1rem' : '0'}"
              }
            },
            {
              "$title": "Idle Quick Links",
              "tagName": "div",
              "style": {
                "display": "${state.searchQuery ? 'none' : 'block'}",
                "padding": "0.3rem 0 0.2rem"
              },
              "children": [
                {
                  "tagName": "div",
                  "textContent": "Jump to",
                  "style": {
                    "padding": "0.25rem 0.7rem 0.35rem",
                    "fontSize": "0.6875rem",
                    "fontWeight": "600",
                    "letterSpacing": "0.06em",
                    "textTransform": "uppercase",
                    "color": "var(--color-text-caption)"
                  }
                },
                {
                  "$prototype": "Array",
                  "items": {
                    "$ref": "#/state/links"
                  },
                  "map": {
                    "tagName": "a",
                    "attributes": {
                      "href": "${$map.item.href}",
                      "class": "quick-link"
                    },
                    "textContent": "${$map.item.label}"
                  }
                }
              ]
            }
          ]
        },
        {
          "$title": "Search Footer",
          "tagName": "div",
          "style": {
            "display": "flex",
            "alignItems": "center",
            "justifyContent": "space-between",
            "gap": "1rem",
            "padding": "0.5rem 0.9rem",
            "borderTop": "1px solid var(--color-rule)",
            "backgroundColor": "var(--color-surface-subtle)",
            "fontSize": "0.75rem",
            "color": "var(--color-text-caption)"
          },
          "children": [
            {
              "tagName": "div",
              "style": {
                "display": "flex",
                "alignItems": "center",
                "gap": "0.9rem",
                "@--sm": {
                  "gap": "0.6rem"
                }
              },
              "children": [
                {
                  "tagName": "span",
                  "children": [
                    {
                      "tagName": "kbd",
                      "attributes": {
                        "class": "foot-key"
                      },
                      "textContent": "↵"
                    },
                    "select"
                  ]
                },
                {
                  "tagName": "span",
                  "children": [
                    {
                      "tagName": "kbd",
                      "attributes": {
                        "class": "foot-key"
                      },
                      "textContent": "↑↓"
                    },
                    "navigate"
                  ]
                },
                {
                  "tagName": "span",
                  "style": {
                    "@--sm": {
                      "display": "none"
                    }
                  },
                  "children": [
                    {
                      "tagName": "kbd",
                      "attributes": {
                        "class": "foot-key"
                      },
                      "textContent": "esc"
                    },
                    "close"
                  ]
                }
              ]
            },
            {
              "tagName": "span",
              "textContent": "${state.searchQuery ? state.searchCount + (state.searchCount === 1 ? ' result' : ' results') : 'Search the docs'}"
            }
          ]
        }
      ]
    }
  ]
}
