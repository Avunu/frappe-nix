{
  "$schema": "../document.schema.json",
  "$id": "ProjectSwitcher",
  "$description": "Jump between Avunu's open-source projects and back to avunu.net. A button opens a native popover with a list of links grouped by platform (the disclosure pattern: Enter or Space opens it, Tab walks the links, Escape closes it and leaves focus on the button, and moving focus out of it closes it). The groups are built at build time from the snapshot of https://avunu.net/projects.json (prop: groups), so the list works offline, without JavaScript and when the fetch fails; on load the component fetches the live catalog and swaps it in, never while the list is open. Each entry links to the project's docs site when it has one, else to its page on avunu.net; the current project (prop: current, a slug) carries aria-current. A catalog is read defensively: an entry that is not valid is skipped, a duplicate slug keeps the first entry, and there is a cap. Props: current, groups, endpoint.",
  "tagName": "project-switcher",
  "state": {
    "current": "",
    "groups": [],
    "pending": null,
    "endpoint": "https://avunu.net/projects.json",
    "onMount": {
      "$prototype": "Function",
      "arguments": ["state"],
      "body": "const host = this;\nconst btn = host.querySelector('button.trigger');\nconst menu = host.querySelector('.menu');\nif (!btn || !menu) { return; }\n// switcher:start\nconst MAX_ENTRIES = 300;\nconst hostOf = (href) => { try { return new URL(href).hostname; } catch (e) { return ''; } };\nconst normalize = (doc) => {\n  const out = [];\n  const seen = Object.create(null);\n  if (!doc || doc.version !== 1 || !Array.isArray(doc.projects)) { return out; }\n  doc.projects.forEach((p) => {\n    if (out.length >= MAX_ENTRIES) { return; }\n    try {\n      if (!p || typeof p.slug !== 'string' || typeof p.title !== 'string' || typeof p.platform !== 'string') { return; }\n      const title = p.title.trim().slice(0, 120);\n      if (!p.slug || !title || seen[p.slug] || !/^[a-z][a-z0-9-]{0,30}$/.test(p.platform)) { return; }\n      const docs = typeof p.docs === 'string' && p.docs.indexOf('https://') === 0 ? p.docs : '';\n      const href = docs || (typeof p.page === 'string' ? p.page : '');\n      const host = href.indexOf('https://') === 0 ? hostOf(href) : '';\n      if (!host) { return; }\n      seen[p.slug] = true;\n      out.push({ slug: p.slug, title: title, platform: p.platform, href: href, host: host, docs: !!docs });\n    } catch (e) { /* one bad entry never discards the others */ }\n  });\n  return out;\n};\nconst group = (items, current) => {\n  const labels = { frappe: 'Frappe & ERPNext', odoo: 'Odoo', wordpress: 'WordPress', nixos: 'NixOS', general: 'General' };\n  const order = ['frappe', 'odoo', 'wordpress', 'nixos', 'general'];\n  const by = Object.create(null);\n  items.forEach((it) => { (by[it.platform] = by[it.platform] || []).push(it); });\n  const keys = order.filter((k) => by[k]).concat(Object.keys(by).filter((k) => order.indexOf(k) === -1).sort());\n  return keys.map((k) => ({\n    platform: k,\n    label: Object.prototype.hasOwnProperty.call(labels, k) ? labels[k] : k,\n    items: by[k].slice().sort((a, b) => a.title.localeCompare(b.title, 'en', { sensitivity: 'base' })).map((it) => ({\n      slug: it.slug,\n      title: it.title,\n      href: it.href,\n      current: it.slug === current,\n      caption: it.slug === current ? 'You are here' : (it.docs ? 'Docs' : it.host)\n    }))\n  }));\n};\n// switcher:end\nconst isOpen = () => menu.matches(':popover-open');\nconst place = () => {\n  const r = btn.getBoundingClientRect();\n  const w = menu.offsetWidth || 340;\n  menu.style.top = Math.round(r.bottom + 6) + 'px';\n  menu.style.left = Math.round(Math.max(8, Math.min(r.left, window.innerWidth - w - 8))) + 'px';\n};\nconst MAX_BYTES = 262144;\nconst load = () => {\n  if (typeof fetch !== 'function') { return; }\n  const ctl = typeof AbortController === 'function' ? new AbortController() : null;\n  const timer = ctl ? setTimeout(() => ctl.abort(), 5000) : 0;\n  fetch(state.endpoint, { headers: { Accept: 'application/json' }, credentials: 'omit', mode: 'cors', signal: ctl ? ctl.signal : undefined })\n    .then((res) => (res.ok ? res.text() : Promise.reject(new Error('HTTP ' + res.status))))\n    .then((text) => {\n      clearTimeout(timer);\n      if (text.length > MAX_BYTES) { return; }\n      const next = normalize(JSON.parse(text));\n      if (!next.length) { return; }\n      const groups = group(next, state.current);\n      if (isOpen()) { state.pending = groups; } else { state.groups = groups; }\n    })\n    .catch(() => { clearTimeout(timer); });\n};\nmenu.addEventListener('beforetoggle', (e) => { if (e.newState === 'open') { place(); } });\nmenu.addEventListener('toggle', (e) => {\n  const open = e.newState === 'open';\n  btn.setAttribute('aria-expanded', open ? 'true' : 'false');\n  if (open) { place(); }\n  else if (state.pending) {\n    state.groups = state.pending;\n    state.pending = null;\n  }\n});\n// Tab out of the list closes it, like leaving any disclosure; Escape and a click outside are native.\nmenu.addEventListener('focusout', (e) => {\n  const to = e.relatedTarget;\n  if (isOpen() && to && !menu.contains(to) && to !== btn) { menu.hidePopover(); }\n});\nwindow.addEventListener('resize', () => { if (isOpen()) { place(); } });\nif ('requestIdleCallback' in window) { window.requestIdleCallback(load, { timeout: 3000 }); } else { setTimeout(load, 1200); }"
    }
  },
  "style": {
    "display": "inline-block",
    "& .trigger": {
      "display": "inline-flex",
      "alignItems": "center",
      "gap": "6px",
      "minHeight": "var(--hit)",
      "padding": "0 10px 0 12px",
      "border": "0",
      "borderRadius": "var(--radius-pill)",
      "backgroundColor": "transparent",
      "color": "var(--color-text-muted)",
      "fontSize": "14px",
      "fontWeight": "500",
      "whiteSpace": "nowrap",
      "transition": "background-color 0.15s, color 0.15s"
    },
    "& .trigger .ico": {
      "display": "inline-flex",
      "lineHeight": "0"
    },
    "& .trigger:hover": {
      "backgroundColor": "var(--color-surface-muted)",
      "color": "var(--color-text)"
    },
    "& .trigger[aria-expanded=\"true\"]": {
      "backgroundColor": "var(--color-tint)",
      "color": "var(--color-on-tint)"
    },
    "& .menu": {
      "position": "fixed",
      "inset": "auto",
      "top": "calc(var(--header-h) + 4px)",
      "left": "var(--gutter)",
      "margin": "0",
      "width": "min(380px, calc(100vw - 16px))",
      "maxHeight": "min(72dvh, 34rem)",
      "overflowY": "auto",
      "overscrollBehavior": "contain",
      "padding": "8px",
      "backgroundColor": "var(--color-surface)",
      "color": "var(--color-text)",
      "border": "1px solid var(--color-surface-border)",
      "borderRadius": "var(--radius-xl)",
      "boxShadow": "var(--shadow-dropdown)"
    },
    "@(prefers-reduced-motion: no-preference)": {
      "& .menu": {
        "opacity": "0",
        "transform": "translateY(-4px)",
        "transition": "opacity 0.12s ease, transform 0.12s ease, display 0.12s allow-discrete, overlay 0.12s allow-discrete"
      },
      "& .menu:popover-open": {
        "opacity": "1",
        "transform": "none"
      },
      "@starting-style": {
        "& .menu:popover-open": {
          "opacity": "0",
          "transform": "translateY(-4px)"
        }
      }
    },
    "& .head": {
      "margin": "0",
      "padding": "8px 10px 4px",
      "fontSize": "12px",
      "fontWeight": "600",
      "color": "var(--color-text-caption)"
    },
    "& .group-label": {
      "padding": "10px 10px 4px",
      "fontSize": "12px",
      "fontWeight": "600",
      "color": "var(--color-text-caption)"
    },
    "& .menu a": {
      "display": "flex",
      "alignItems": "baseline",
      "justifyContent": "space-between",
      "gap": "12px",
      "minHeight": "40px",
      "padding": "9px 10px",
      "borderRadius": "var(--radius-sm)",
      "color": "var(--color-text)",
      "textDecoration": "none",
      "fontSize": "14px",
      "lineHeight": "1.35",
      "position": "relative"
    },
    "& .menu a:hover": {
      "backgroundColor": "var(--color-surface-muted)"
    },
    "& .menu a:focus-visible": {
      "backgroundColor": "var(--color-surface-muted)",
      "outline": "2px solid var(--color-focus)",
      "outlineOffset": "-2px"
    },
    "& .menu a[aria-current=\"true\"]": {
      "backgroundColor": "var(--color-tint)",
      "color": "var(--color-on-tint)",
      "fontWeight": "600"
    },
    "& .menu a .c": {
      "flex": "none",
      "fontSize": "12px",
      "fontWeight": "400",
      "color": "var(--color-text-caption)",
      "whiteSpace": "nowrap"
    },
    "& .menu a[aria-current=\"true\"] .c": {
      "color": "var(--color-on-tint)"
    },
    "& .rule": {
      "height": "1px",
      "margin": "6px 4px",
      "backgroundColor": "var(--color-rule)"
    },
    "@--sm": {
      "& .trigger .label": {
        "position": "absolute",
        "width": "1px",
        "height": "1px",
        "overflow": "hidden",
        "clip": "rect(0 0 0 0)",
        "whiteSpace": "nowrap"
      },
      "& .trigger": {
        "padding": "0 8px"
      }
    },
    "@(pointer: coarse)": {
      "& .menu a": {
        "minHeight": "var(--hit)"
      }
    },
    "& .menu a .t": {
      "overflowWrap": "anywhere",
      "minWidth": "0"
    },
    "& .menu ul": {
      "listStyle": "none",
      "margin": "0",
      "padding": "0"
    }
  },
  "children": [
    {
      "tagName": "button",
      "attributes": {
        "type": "button",
        "class": "trigger",
        "id": "project-switcher-button",
        "aria-expanded": "false",
        "aria-controls": "project-switcher-menu",
        "popovertarget": "project-switcher-menu"
      },
      "children": [
        {
          "tagName": "span",
          "attributes": {
            "class": "ico",
            "aria-hidden": "true"
          },
          "children": [
            {
              "tagName": "svg",
              "attributes": {
                "viewBox": "0 0 24 24",
                "width": "18",
                "height": "18",
                "fill": "none",
                "stroke": "currentColor",
                "stroke-width": "1.6",
                "stroke-linecap": "round",
                "stroke-linejoin": "round",
                "aria-hidden": "true",
                "focusable": "false"
              },
              "children": [
                {
                  "tagName": "path",
                  "attributes": {
                    "d": "M4.5 3h4A1.5 1.5 0 0 1 10 4.5v4A1.5 1.5 0 0 1 8.5 10h-4A1.5 1.5 0 0 1 3 8.5v-4A1.5 1.5 0 0 1 4.5 3zM15.5 3h4A1.5 1.5 0 0 1 21 4.5v4a1.5 1.5 0 0 1-1.5 1.5h-4A1.5 1.5 0 0 1 14 8.5v-4A1.5 1.5 0 0 1 15.5 3zM4.5 14h4A1.5 1.5 0 0 1 10 15.5v4A1.5 1.5 0 0 1 8.5 21h-4A1.5 1.5 0 0 1 3 19.5v-4A1.5 1.5 0 0 1 4.5 14zM15.5 14h4a1.5 1.5 0 0 1 1.5 1.5v4a1.5 1.5 0 0 1-1.5 1.5h-4a1.5 1.5 0 0 1-1.5-1.5v-4a1.5 1.5 0 0 1 1.5-1.5z"
                  }
                }
              ]
            }
          ]
        },
        {
          "tagName": "span",
          "attributes": {
            "class": "label"
          },
          "textContent": "Projects"
        },
        {
          "tagName": "span",
          "attributes": {
            "class": "ico",
            "aria-hidden": "true"
          },
          "children": [
            {
              "tagName": "svg",
              "attributes": {
                "viewBox": "0 0 24 24",
                "width": "16",
                "height": "16",
                "fill": "none",
                "stroke": "currentColor",
                "stroke-width": "1.6",
                "stroke-linecap": "round",
                "stroke-linejoin": "round",
                "aria-hidden": "true",
                "focusable": "false"
              },
              "children": [
                {
                  "tagName": "path",
                  "attributes": {
                    "d": "m6 9 6 6 6-6"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "tagName": "nav",
      "attributes": {
        "class": "menu",
        "id": "project-switcher-menu",
        "popover": "auto",
        "aria-labelledby": "project-switcher-head"
      },
      "children": [
        {
          "tagName": "p",
          "attributes": {
            "class": "head",
            "id": "project-switcher-head"
          },
          "textContent": "Avunu open-source projects"
        },
        {
          "tagName": "div",
          "attributes": {
            "class": "lists"
          },
          "children": [
            {
              "$prototype": "Array",
              "items": {
                "$ref": "#/state/groups"
              },
              "map": {
                "tagName": "div",
                "attributes": {
                  "class": "group"
                },
                "children": [
                  {
                    "tagName": "p",
                    "attributes": {
                      "class": "group-label"
                    },
                    "textContent": "${$map.item.label}"
                  },
                  {
                    "tagName": "ul",
                    "attributes": {
                      "aria-label": "${$map.item.label}"
                    },
                    "children": [
                      {
                        "$prototype": "Array",
                        "items": {
                          "$ref": "$map/item/items"
                        },
                        "map": {
                          "tagName": "li",
                          "children": [
                            {
                              "tagName": "a",
                              "attributes": {
                                "href": "${$map.item.href}",
                                "aria-current": "${$map.item.current ? 'true' : 'false'}",
                                "aria-label": "${$map.item.title}, ${$map.item.caption}"
                              },
                              "children": [
                                {
                                  "tagName": "span",
                                  "attributes": {
                                    "class": "t"
                                  },
                                  "textContent": "${$map.item.title}"
                                },
                                {
                                  "tagName": "span",
                                  "attributes": {
                                    "class": "c"
                                  },
                                  "textContent": "${$map.item.caption}"
                                }
                              ]
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              }
            },
            {
              "tagName": "div",
              "attributes": {
                "class": "rule",
                "aria-hidden": "true"
              }
            },
            {
              "tagName": "div",
              "attributes": {
                "class": "group"
              },
              "children": [
                {
                  "tagName": "p",
                  "attributes": {
                    "class": "group-label"
                  },
                  "textContent": "Avunu"
                },
                {
                  "tagName": "ul",
                  "attributes": {
                    "aria-label": "Avunu"
                  },
                  "children": [
                    {
                      "tagName": "li",
                      "children": [
                        {
                          "tagName": "a",
                          "attributes": {
                            "href": "https://avunu.net/open-source/",
                            "aria-label": "All open-source projects, avunu.net"
                          },
                          "children": [
                            {
                              "tagName": "span",
                              "attributes": {
                                "class": "t"
                              },
                              "textContent": "All open-source projects"
                            },
                            {
                              "tagName": "span",
                              "attributes": {
                                "class": "c"
                              },
                              "textContent": "avunu.net"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "tagName": "li",
                      "children": [
                        {
                          "tagName": "a",
                          "attributes": {
                            "href": "https://avunu.net/",
                            "aria-label": "Back to avunu.net, avunu.net"
                          },
                          "children": [
                            {
                              "tagName": "span",
                              "attributes": {
                                "class": "t"
                              },
                              "textContent": "Back to avunu.net"
                            },
                            {
                              "tagName": "span",
                              "attributes": {
                                "class": "c"
                              },
                              "textContent": "avunu.net"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
