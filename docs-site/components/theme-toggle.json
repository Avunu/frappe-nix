{
  "$schema": "../document.schema.json",
  "$id": "ThemeToggle",
  "$description": "Colour theme switch: cycles auto (follow the device), light, dark. Persists the choice under the Jx jx-color-scheme key and mirrors it on <html data-color-scheme>, so it survives navigation without a flash. A 44px icon button; the icon shows the current mode and a polite status message announces each change.",
  "tagName": "theme-toggle",
  "state": {
    "scheme": "auto",
    "message": "",
    "cycle": {
      "$prototype": "Function",
      "arguments": ["state"],
      "body": "const order = ['auto', 'light', 'dark']; const next = order[(order.indexOf(state.scheme) + 1) % 3]; state.scheme = next; state.message = 'Colour theme: ' + next; try { if (next === 'auto') { localStorage.removeItem('jx-color-scheme'); } else { localStorage.setItem('jx-color-scheme', next); } } catch (e) {} if (next === 'auto') { document.documentElement.removeAttribute('data-color-scheme'); } else { document.documentElement.setAttribute('data-color-scheme', next); } document.dispatchEvent(new CustomEvent('jx-color-scheme', { detail: next }));"
    },
    "onMount": {
      "$prototype": "Function",
      "arguments": ["state"],
      "body": "state.scheme = document.documentElement.getAttribute('data-color-scheme') || 'auto'; document.addEventListener('jx-color-scheme', (e) => { state.scheme = e.detail; });"
    }
  },
  "style": {
    "display": "inline-flex"
  },
  "children": [
    {
      "tagName": "button",
      "style": {
        "display": "inline-flex",
        "alignItems": "center",
        "justifyContent": "center",
        "width": "var(--hit)",
        "height": "var(--hit)",
        "padding": "0",
        "border": "0",
        "borderRadius": "50%",
        "backgroundColor": "transparent",
        "color": "inherit",
        "transition": "background-color 0.15s",
        ":hover": {
          "backgroundColor": "var(--color-surface-muted)"
        },
        "& .ico, & .ico span": {
          "display": "inline-flex",
          "lineHeight": "0"
        },
        "& .ico .l, & .ico .d": {
          "display": "none"
        },
        "& .ico[data-scheme=\"light\"] .a, & .ico[data-scheme=\"dark\"] .a": {
          "display": "none"
        },
        "& .ico[data-scheme=\"light\"] .l, & .ico[data-scheme=\"dark\"] .d": {
          "display": "inline-flex"
        },
        "&:focus-visible": {
          "outline": "2px solid var(--color-focus)",
          "outlineOffset": "2px"
        }
      },
      "attributes": {
        "type": "button",
        "aria-label": "Colour theme: switch between automatic, light and dark"
      },
      "onclick": {
        "$ref": "#/state/cycle"
      },
      "children": [
        {
          "tagName": "span",
          "attributes": {
            "class": "ico",
            "aria-hidden": "true",
            "data-scheme": "${state.scheme}"
          },
          "children": [
            {
              "tagName": "span",
              "attributes": {
                "class": "a"
              },
              "children": [
                {
                  "tagName": "svg",
                  "attributes": {
                    "viewBox": "0 0 24 24",
                    "width": "20",
                    "height": "20",
                    "fill": "none",
                    "stroke": "currentColor",
                    "stroke-width": "1.6",
                    "stroke-linecap": "round",
                    "stroke-linejoin": "round",
                    "aria-hidden": "true",
                    "focusable": "false"
                  },
                  "children": [
                    {
                      "tagName": "path",
                      "attributes": {
                        "d": "M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM8 21h8M12 17v4"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "tagName": "span",
              "attributes": {
                "class": "l"
              },
              "children": [
                {
                  "tagName": "svg",
                  "attributes": {
                    "viewBox": "0 0 24 24",
                    "width": "20",
                    "height": "20",
                    "fill": "none",
                    "stroke": "currentColor",
                    "stroke-width": "1.6",
                    "stroke-linecap": "round",
                    "stroke-linejoin": "round",
                    "aria-hidden": "true",
                    "focusable": "false"
                  },
                  "children": [
                    {
                      "tagName": "path",
                      "attributes": {
                        "d": "M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "tagName": "span",
              "attributes": {
                "class": "d"
              },
              "children": [
                {
                  "tagName": "svg",
                  "attributes": {
                    "viewBox": "0 0 24 24",
                    "width": "20",
                    "height": "20",
                    "fill": "none",
                    "stroke": "currentColor",
                    "stroke-width": "1.6",
                    "stroke-linecap": "round",
                    "stroke-linejoin": "round",
                    "aria-hidden": "true",
                    "focusable": "false"
                  },
                  "children": [
                    {
                      "tagName": "path",
                      "attributes": {
                        "d": "M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11z"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "tagName": "span",
      "attributes": {
        "role": "status",
        "class": "sr-only"
      },
      "textContent": "${state.message}"
    }
  ]
}
