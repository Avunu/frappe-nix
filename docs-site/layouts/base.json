{
  "$schema": "../document.schema.json",
  "$description": "The page shell shared by every page: skip link, the docs header (Avunu mark, project name, project switcher, search, theme toggle, GitHub link), the page itself in the default slot, the Night footer and the enhancement island. Pages bring their own <main id=\"main\">. Site data comes from docs.config.json (state.config), the project catalog snapshot (state.catalog) and the generated sidebar data (state.nav). Everything derived is a compiler-timed Function, so pages ship no page JavaScript. Page metadata a page may override with its own state: description, ogTitle, ogType, robots.",
  "tagName": "div",
  "state": {
    "config": {
      "$prototype": "ContentEntry",
      "contentType": "config",
      "id": "docs.config",
      "timing": "compiler"
    },
    "catalog": {
      "$prototype": "ContentEntry",
      "contentType": "projects",
      "id": "projects.snapshot",
      "timing": "compiler"
    },
    "nav": {
      "$prototype": "ContentEntry",
      "contentType": "nav",
      "id": "nav",
      "timing": "compiler"
    },
    "here": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "return state.$page.url.endsWith('/') ? state.$page.url : state.$page.url + '/'"
    },
    "switcherGroups": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "// switcher:start\nconst MAX_ENTRIES = 300;\nconst hostOf = (href) => { try { return new URL(href).hostname; } catch (e) { return ''; } };\nconst normalize = (doc) => {\n  const out = [];\n  const seen = Object.create(null);\n  if (!doc || doc.version !== 1 || !Array.isArray(doc.projects)) { return out; }\n  doc.projects.forEach((p) => {\n    if (out.length >= MAX_ENTRIES) { return; }\n    try {\n      if (!p || typeof p.slug !== 'string' || typeof p.title !== 'string' || typeof p.platform !== 'string') { return; }\n      const title = p.title.trim().slice(0, 120);\n      if (!p.slug || !title || seen[p.slug] || !/^[a-z][a-z0-9-]{0,30}$/.test(p.platform)) { return; }\n      const docs = typeof p.docs === 'string' && p.docs.indexOf('https://') === 0 ? p.docs : '';\n      const href = docs || (typeof p.page === 'string' ? p.page : '');\n      const host = href.indexOf('https://') === 0 ? hostOf(href) : '';\n      if (!host) { return; }\n      seen[p.slug] = true;\n      out.push({ slug: p.slug, title: title, platform: p.platform, href: href, host: host, docs: !!docs });\n    } catch (e) { /* one bad entry never discards the others */ }\n  });\n  return out;\n};\nconst group = (items, current) => {\n  const labels = { frappe: 'Frappe & ERPNext', odoo: 'Odoo', wordpress: 'WordPress', nixos: 'NixOS', general: 'General' };\n  const order = ['frappe', 'odoo', 'wordpress', 'nixos', 'general'];\n  const by = Object.create(null);\n  items.forEach((it) => { (by[it.platform] = by[it.platform] || []).push(it); });\n  const keys = order.filter((k) => by[k]).concat(Object.keys(by).filter((k) => order.indexOf(k) === -1).sort());\n  return keys.map((k) => ({\n    platform: k,\n    label: Object.prototype.hasOwnProperty.call(labels, k) ? labels[k] : k,\n    items: by[k].slice().sort((a, b) => a.title.localeCompare(b.title, 'en', { sensitivity: 'base' })).map((it) => ({\n      slug: it.slug,\n      title: it.title,\n      href: it.href,\n      current: it.slug === current,\n      caption: it.slug === current ? 'You are here' : (it.docs ? 'Docs' : it.host)\n    }))\n  }));\n};\n// switcher:end\nreturn group(normalize(state.catalog.data), state.config.data.slug);"
    },
    "searchLinks": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "return [{ label: 'Browse the documentation', href: '/docs/' }].concat(state.nav.data.sections.map((s) => ({ label: s.label, href: s.url || s.pages[0].url })));"
    },
    "description": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "return state.config.data.tagline"
    },
    "ogTitle": {
      "$prototype": "Function",
      "timing": "compiler",
      "body": "return state.config.data.name"
    },
    "ogType": {
      "timing": "compiler",
      "default": "website"
    },
    "robots": {
      "timing": "compiler",
      "default": "index, follow"
    }
  },
  "$head": [
    {
      "tagName": "meta",
      "attributes": {
        "name": "description",
        "content": "${state.description}"
      }
    },
    {
      "tagName": "meta",
      "attributes": {
        "name": "robots",
        "content": "${state.robots}"
      }
    },
    {
      "tagName": "meta",
      "attributes": {
        "property": "og:type",
        "content": "${state.ogType}"
      }
    },
    {
      "tagName": "meta",
      "attributes": {
        "property": "og:title",
        "content": "${state.ogTitle}"
      }
    },
    {
      "tagName": "meta",
      "attributes": {
        "property": "og:description",
        "content": "${state.description}"
      }
    },
    {
      "tagName": "meta",
      "attributes": {
        "name": "twitter:card",
        "content": "summary"
      }
    },
    {
      "tagName": "meta",
      "attributes": {
        "name": "twitter:title",
        "content": "${state.ogTitle}"
      }
    },
    {
      "tagName": "meta",
      "attributes": {
        "name": "twitter:description",
        "content": "${state.description}"
      }
    }
  ],
  "style": {
    "@font-face": [
      {
        "font-family": "Figtree",
        "font-style": "normal",
        "font-weight": "300 900",
        "font-display": "swap",
        "src": "url(\"/fonts/figtree-latin-wght-normal.woff2\") format(\"woff2\")",
        "unicode-range": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
      },
      {
        "font-family": "Figtree",
        "font-style": "normal",
        "font-weight": "300 900",
        "font-display": "swap",
        "src": "url(\"/fonts/figtree-latin-ext-wght-normal.woff2\") format(\"woff2\")",
        "unicode-range": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
      },
      {
        "font-family": "Figtree",
        "font-style": "italic",
        "font-weight": "300 900",
        "font-display": "swap",
        "src": "url(\"/fonts/figtree-latin-wght-italic.woff2\") format(\"woff2\")",
        "unicode-range": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
      },
      {
        "font-family": "JetBrains Mono",
        "font-style": "normal",
        "font-weight": "400",
        "font-display": "swap",
        "src": "url(\"/fonts/jetbrains-mono-latin-400-normal.woff2\") format(\"woff2\")",
        "unicode-range": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
      },
      {
        "font-family": "JetBrains Mono",
        "font-style": "normal",
        "font-weight": "400",
        "font-display": "swap",
        "src": "url(\"/fonts/jetbrains-mono-latin-ext-400-normal.woff2\") format(\"woff2\")",
        "unicode-range": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
      },
      {
        "font-family": "JetBrains Mono",
        "font-style": "normal",
        "font-weight": "500",
        "font-display": "swap",
        "src": "url(\"/fonts/jetbrains-mono-latin-500-normal.woff2\") format(\"woff2\")",
        "unicode-range": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
      }
    ],
    "display": "flex",
    "flexDirection": "column",
    "minHeight": "100dvh",
    "& > main": {
      "flex": "1 0 auto",
      "minWidth": "0"
    }
  },
  "children": [
    {
      "tagName": "a",
      "attributes": {
        "class": "skip-link",
        "href": "#main"
      },
      "textContent": "Skip to content"
    },
    {
      "tagName": "docs-header",
      "children": [
        {
          "tagName": "div",
          "attributes": {
            "class": "left"
          },
          "children": [
            {
              "tagName": "a",
              "attributes": {
                "class": "mark",
                "href": "https://avunu.net/",
                "aria-label": "Avunu, go to avunu.net"
              },
              "children": [
                {
                  "tagName": "img",
                  "attributes": {
                    "src": "/brand/avunu-icon.svg",
                    "alt": "",
                    "width": "28",
                    "height": "28",
                    "loading": "eager"
                  }
                }
              ]
            },
            {
              "tagName": "span",
              "attributes": {
                "class": "sep",
                "aria-hidden": "true"
              },
              "textContent": "/"
            },
            {
              "tagName": "a",
              "attributes": {
                "class": "name",
                "href": "/"
              },
              "textContent": "${state.config.data.name}"
            },
            {
              "tagName": "project-switcher",
              "$props": {
                "current": "${state.config.data.slug}",
                "groups": "${state.switcherGroups}"
              }
            }
          ]
        },
        {
          "tagName": "div",
          "attributes": {
            "class": "right"
          },
          "children": [
            {
              "tagName": "docs-search",
              "$props": {
                "variant": "field",
                "label": "Search the docs",
                "links": "${state.searchLinks}"
              },
              "attributes": {
                "role": "search"
              }
            },
            {
              "tagName": "theme-toggle"
            },
            {
              "tagName": "a",
              "attributes": {
                "class": "gh",
                "href": "${state.config.data.repo}",
                "aria-label": "${state.config.data.name} on GitHub"
              },
              "children": [
                {
                  "tagName": "docs-icon",
                  "$props": {
                    "name": "github",
                    "size": "22"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "tagName": "slot"
    },
    {
      "tagName": "docs-footer",
      "$props": {
        "name": "${state.config.data.name}",
        "repo": "${state.config.data.repo}",
        "license": "${state.config.data.license}",
        "docs": "/docs/"
      }
    },
    {
      "tagName": "docs-enhance"
    }
  ]
}
