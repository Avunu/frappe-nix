{
	"name": "flow-ui-workspace",
	"lockfileVersion": 3,
	"requires": true,
	"packages": {
		"": {
			"name": "flow-ui-workspace",
			"workspaces": ["core", "app"]
		},
		"app": {
			"name": "flow-web",
			"version": "0.0.0",
			"dependencies": {
				"@flow/ui-core": "0.0.0"
			}
		},
		"core": {
			"name": "@flow/ui-core",
			"version": "0.0.0"
		},
		"node_modules/@flow/ui-core": {
			"resolved": "core",
			"link": true
		},
		"node_modules/flow-web": {
			"resolved": "app",
			"link": true
		}
	}
}
