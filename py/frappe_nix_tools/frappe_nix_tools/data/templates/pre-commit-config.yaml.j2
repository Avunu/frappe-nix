#
# Run by prek (`prek install` once per clone; the dev shell does it) and by CI's `lint` job:
#   uv run --frozen --project tools prek run --all-files --show-diff-on-failure
# A hook that rewrites a file fails CI. ruff, ty, committed, zizmor, actionlint and shellcheck are pinned
# by tools/uv.lock; oxfmt, oxlint and stylelint by package.json; ssort, pre-commit-hooks and test_utils by the
# `rev:`s below. dependabot moves all three.
{% set compat = modules.metadata or modules.releases or modules["vite-register"] or modules.tests or modules.typescript or modules.hygiene %}
{% set stylelint = modules.stylelint and discover.scss %}
{% set major_rule = modules.commits and modules.releases and cfg.releases["version-scheme"] == "frappe-major" %}
{% set local = modules["python-lint"] or modules.js or stylelint or modules["workflow-lint"] or modules["shell-lint"] or compat or modules.commits %}
{% set tu = cfg["test-utils"].hooks %}
default_install_hook_types: [{{ "pre-commit, commit-msg" if modules.commits else "pre-commit" }}]
default_stages: [pre-commit]
default_language_version:
  python: python3.14
fail_fast: false
exclude: ^(nix/|\.frappe-nix/|docs-site/|CHANGELOG\.md$|types/doctypes\.d\.ts${% for g in cfg.generated %}|{{ g | glob_to_regex }}{% endfor %})

repos:
{% if modules.hygiene %}
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: {{ rev("https://github.com/pre-commit/pre-commit-hooks", "v6.0.0") }}
    hooks:
      - id: check-merge-conflict
      - id: check-ast
      - id: check-toml
      - id: check-yaml
        args: [--allow-multiple-documents]
      - id: check-json
        exclude: ^(tsconfig(\.[a-z]+)?\.json|\.vscode/.*)$
      - id: debug-statements
      - id: detect-private-key
      - id: check-added-large-files
        args: [--maxkb={{ cfg.hygiene["max-file-kb"] }}]
        exclude: ^docs/screenshots/

{% endif %}
{% if modules.ssort %}
  # Definitions before their first use; nothing else reordered. ssort can't resolve names
  # imported inside the class-body `if TYPE_CHECKING:` block frappe generates, so only
  # <doctype>/<doctype>.py controllers are excluded. Tests and helpers in doctype folders are sorted.
  - repo: https://github.com/bwhmather/ssort
    rev: {{ rev("https://github.com/bwhmather/ssort", "0.17.0") }}
    hooks:
      - id: ssort
        exclude: '/doctype/([^/]+)/\1\.py$'

{% endif %}
{% if local %}
  - repo: local
    hooks:
{% if modules["python-lint"] %}
      - id: ruff-isort
        name: ruff import sorter
        language: system
        entry: uv run --frozen --project tools ruff check --select I --fix
        types: [python]
      - id: ruff-check
        name: ruff check
        language: system
        entry: uv run --frozen --project tools ruff check --fix
        types: [python]
      - id: ruff-format
        name: ruff format
        language: system
        entry: uv run --frozen --project tools ruff format
        types: [python]
{% endif %}
{% if modules.js %}
      - id: oxfmt
        name: oxfmt
        language: system
        entry: yarn -s oxfmt
        pass_filenames: false
        always_run: true
      - id: oxlint
        name: oxlint
        language: system
        entry: yarn -s oxlint
        pass_filenames: false
        types_or: [javascript, jsx, ts, tsx, vue]
{% endif %}
{% if stylelint %}
      - id: stylelint
        name: stylelint
        language: system
        entry: yarn -s stylelint {% for g in discover.scss %}{{ g | json_string }}{{ " " if not loop.last else "" }}{% endfor %}

        pass_filenames: false
        types: [scss]
{% endif %}
{% if modules["workflow-lint"] %}
      - id: zizmor
        name: zizmor
        language: system
        entry: uv run --frozen --project tools zizmor --config .github/zizmor.yml .github/workflows .github/dependabot.yml
        pass_filenames: false
        files: ^\.github/
      - id: actionlint
        name: actionlint
        language: system
        entry: uv run --frozen --project tools actionlint
        pass_filenames: false
        files: ^\.github/workflows/
{% endif %}
{% if modules["shell-lint"] %}
      - id: shellcheck
        name: shellcheck
        language: system
        entry: uv run --frozen --project tools shellcheck --severity=warning
        types: [shell]
        exclude: ^\.envrc$
{% endif %}
{% if compat %}
      # Outside the dev shell (a GUI client, an editor's commit button) frappe-nix is not on
      # PATH: the hook says so and passes, and CI's lint job runs it with frappe-nix installed.
      - id: frappe-nix-compat
        name: frappe-nix compat (versions, ranges, majors)
        language: system
        entry: sh -c 'if command -v frappe-nix >/dev/null; then exec frappe-nix compat; fi; echo "frappe-nix-compat skipped (frappe-nix not on PATH; CI runs it)" >&2'
        pass_filenames: false
        always_run: true
        verbose: true
{% endif %}
{% if modules.commits %}
      - id: committed
        name: committed (conventional commit)
        language: system
        entry: uv run --frozen --project tools committed --commit-file
        stages: [commit-msg]
{% endif %}
{% if major_rule %}
      - id: frappe-nix-commit-msg
        name: no major bump through a commit message
        language: system
        entry: sh -c 'if command -v frappe-nix >/dev/null; then exec frappe-nix policy --commit-msg-file "$1"; fi; echo "frappe-nix-commit-msg skipped (frappe-nix not on PATH; pr-policy runs it)" >&2' --
        stages: [commit-msg]
{% endif %}

{% endif %}
{% if modules["test-utils"] and tu %}
  # agritheory/test_utils: selected hooks only (S19). sql_registry/sql_rewriter abort the run,
  # mypy is replaced by ty, and validate_*_dependencies crash outside a bench, so none of those are here.
  - repo: https://github.com/agritheory/test_utils
    rev: {{ rev("https://github.com/agritheory/test_utils", "v1.30.1") }}
    hooks:
{% if "validate_frappe_project" in tu %}
      - id: validate_frappe_project
{% endif %}
{% if "validate_patches" in tu and discover.patches_dir %}
      - id: validate_patches
        args: [--app, {{ app }}]
{% endif %}
{% if "static_analysis" in tu %}
      - id: static_analysis
        args: ["."]
{% endif %}
{% if "validate_doctype_python_types" in tu %}
      - id: validate_doctype_python_types
{% endif %}
{% if "validate_copyright" in tu %}
      - id: validate_copyright
        args: [--app, {{ app }}]
        # Never stamp a managed file (its header is line 1, or it is the profile's), or a generated one (its
        # freshness diff would fail), nor a script: a stamp above `#!/usr/bin/env node` breaks it (scripts/ and
        # ci/ hold the node tools).
        exclude: ^(docs/|docs-site/|scripts/|ci/|marketplace/shots\.d\.ts$|types/doctypes\.d\.ts$|tsconfig[^/]*\.json${% for e in cfg["extra-files"] %}|{{ e.path | glob_to_regex }}{% endfor %}{% for g in cfg.generated %}|{{ g | glob_to_regex }}{% endfor %})
        exclude_types: [executable]
{% endif %}
{% if "validate_customizations" in tu or "clean_customized_doctypes" in tu %}
      # Bench-aware: silent no-ops outside a bench. CI runs them in a mini-bench (`frappe-nix minibench`).
{% endif %}
{% if "validate_customizations" in tu %}
      - id: validate_customizations
        stages: [manual]
{% endif %}
{% if "clean_customized_doctypes" in tu %}
      - id: clean_customized_doctypes
        stages: [manual]
{% endif %}
{% if "check_code_duplication" in tu %}
      # Nightly only (jscpd through npx, needs the network).
      - id: check_code_duplication
        stages: [manual]
{% endif %}
{% if cfg["test-utils"]["track-overrides"] %}
      - id: track_overrides
        args: [--app, {{ app }}, --base-branch, {{ frappe.branch }}]
{% endif %}

{% endif %}
  # frappe-nix:local-begin repos
  # frappe-nix:local-end repos
