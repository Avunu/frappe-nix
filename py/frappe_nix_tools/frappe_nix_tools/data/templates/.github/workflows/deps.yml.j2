# Dependency PRs (docs: ci.md): relock and sync after a flake bump, auto-merge by the
# decision table, and the sweep that re-dispatches CI for bot PRs (§4.5).
{% set sweep = cfg.ci.schedules["deps-sweep"] %}
{% set relock = cfg.ci.schedules["deps-relock"] %}
{# The locked frappe-nix revision. A lock without one (a path: override, as frappe-nix's own self-tests
   lock it) keeps the file's pin: this workflow's, else the one the file's lint job calls. #}
{% macro uses(workflow) %}
{% set at = frappe_nix.owner ~ "/" ~ frappe_nix.name ~ "/.github/workflows/" %}
{% if frappe_nix.rev %}
{{ at ~ workflow }}@{{ frappe_nix.rev }} # v{{ frappe_nix.version }}
{%- else %}
{% set kept = pin(at ~ workflow, "", "v" ~ frappe_nix.version) %}
{% if "@ #" in kept %}
{% set kept = pin(at ~ "app-lint.yml", "", "v" ~ frappe_nix.version).replace("app-lint.yml", workflow) %}
{% endif %}
{{ kept }}
{%- endif %}
{% endmacro %}
name: deps
on:
  pull_request:
{% if sweep or relock %}
  schedule:
{% if sweep %}
    # Re-dispatch CI for bot PRs.
    - cron: "{{ sweep }}"
{% endif %}
{% if relock %}
    # The weekly Python relock; passed as relock-cron below.
    - cron: "{{ relock }}"
{% endif %}
{% endif %}
  workflow_dispatch:
permissions: {}
jobs:
  deps:
    permissions:
      contents: write
      pull-requests: write
      actions: write
      checks: read
    uses: {{ uses("app-deps.yml") }}
    with:
      app: {{ app }}
      integration-branch: {{ branches.integration }}
{% if cfg.ci["runs-on"] is defined %}
      runs-on: {{ cfg.ci["runs-on"] | yaml_json }}
{% endif %}
      nix-cache: {% raw %}${{ vars.FRAPPE_NIX_CACHE || '' }}{% endraw %}

      auto-merge: {{ "true" if cfg.dependabot["auto-merge"] else "false" }}
      merge-method: {{ cfg["repo-policy"]["merge-methods"][0] }}
      relock-cron: "{{ relock }}"
    secrets:
      NIX_CACHE_TOKEN: {% raw %}${{ secrets.FRAPPE_NIX_CACHE_TOKEN }}{% endraw %}

      NIX_CACHE_READ_TOKEN: {% raw %}${{ secrets.FRAPPE_NIX_CACHE_READ_TOKEN }}{% endraw %}

      FETCH_TOKEN: {% raw %}${{ secrets.FRAPPE_NIX_FETCH_TOKEN }}{% endraw %}

